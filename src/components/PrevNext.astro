---
interface Card {
  href: string;
  title: string;
  kicker: string;
}
interface Props {
  label: string;
  backHref: string;
  backLabel: string;
  prev?: Card;
  next?: Card;
}
const { label, backHref, backLabel, prev, next } = Astro.props;
const card =
  'block rounded-[22px] border-[1.5px] border-card-line-cool bg-surface px-7 py-[22px] transition hover:border-primary';
---

<nav aria-label={label} class="no-print mt-[60px] border-t border-line-strong pt-[52px]">
  <div class="grid gap-[18px] sm:grid-cols-2">
    {prev ? (
      <a href={prev.href} rel="prev" class={card}>
        <span class="flex items-center gap-2.5 font-label text-sm font-bold text-ink-soft">
          <span aria-hidden="true" class="text-lg leading-none">&larr;</span>Previous
        </span>
        <span class="mt-3 block font-label text-xs font-bold uppercase tracking-[0.18em] text-primary-text">{prev.kicker}</span>
        <span class="mt-1.5 block font-display text-xl font-extrabold leading-[1.26] text-navy">{prev.title}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {next && (
      <a href={next.href} rel="next" class:list={[card, 'text-right']}>
        <span class="flex items-center justify-end gap-2.5 font-label text-sm font-bold text-ink-soft">
          Next<span aria-hidden="true" class="text-lg leading-none">&rarr;</span>
        </span>
        <span class="mt-3 block font-label text-xs font-bold uppercase tracking-[0.18em] text-primary-text">{next.kicker}</span>
        <span class="mt-1.5 block font-display text-xl font-extrabold leading-[1.26] text-navy">{next.title}</span>
      </a>
    )}
  </div>
  <p class="mt-[26px] text-center">
    <a href={backHref} class="font-label text-[15px] font-bold text-primary-text hover:text-navy">{backLabel}</a>
  </p>
</nav>
