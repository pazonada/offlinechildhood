---
interface Neighbour {
  href: string;
  title: string;
  /** Shown above the title, e.g. "Decision 3" or the strand name. */
  kicker?: string;
}

interface Props {
  prev?: Neighbour;
  next?: Neighbour;
  backHref: string;
  backLabel: string;
  /** Describes what is being paged through, for screen readers. */
  label: string;
}

const { prev, next, backHref, backLabel, label } = Astro.props;

const card =
  'group flex h-full flex-col rounded-2xl border-2 border-line bg-surface p-5 transition hover:border-primary hover:bg-surface-2';
---

<nav aria-label={label} class="no-print mt-16 border-t border-line pt-10">
  <div class="grid gap-4 sm:grid-cols-2">
    {prev ? (
      <a href={prev.href} rel="prev" class:list={[card, 'items-start text-left']}>
        <span class="flex items-center gap-1.5 text-sm font-bold text-ink-soft">
          <span aria-hidden="true" class="inline-block transition group-hover:-translate-x-1">&larr;</span>
          Previous
        </span>
        {prev.kicker && (
          <span class="mt-3 font-display text-xs font-bold uppercase tracking-[0.12em] text-primary-text">
            {prev.kicker}
          </span>
        )}
        <span class="mt-1 font-display text-lg font-extrabold text-ink">{prev.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" aria-hidden="true"></div>
    )}

    {next && (
      <a href={next.href} rel="next" class:list={[card, 'items-end text-right']}>
        <span class="flex items-center gap-1.5 text-sm font-bold text-ink-soft">
          Next
          <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&rarr;</span>
        </span>
        {next.kicker && (
          <span class="mt-3 font-display text-xs font-bold uppercase tracking-[0.12em] text-primary-text">
            {next.kicker}
          </span>
        )}
        <span class="mt-1 font-display text-lg font-extrabold text-ink">{next.title}</span>
      </a>
    )}
  </div>

  <p class="mt-6 text-center">
    <a
      href={backHref}
      class="font-display font-bold text-primary-text underline underline-offset-4 hover:text-ink"
    >
      {backLabel}
    </a>
  </p>
</nav>
