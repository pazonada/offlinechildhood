---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
}
const { src, alt, caption, class: className = '' } = Astro.props;

// Held to the image's own width rather than stretched. These are phone
// photographs, and a picture used at its real size reads as deliberate where an
// upscaled one just looks soft.
const maxW = Math.min(src.width, 900);
---
<figure class:list={['not-prose', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[Math.round(maxW / 2), maxW]}
    sizes={`(max-width: 700px) 100vw, ${maxW}px`}
    loading="lazy"
    decoding="async"
    class="w-full rounded-3xl border border-line bg-surface-2"
    style={`max-width:${maxW}px`}
  />
  {caption && (
    <figcaption class="mt-3 text-sm text-ink-soft" style={`max-width:${maxW}px`}>
      {caption}
    </figcaption>
  )}
</figure>
