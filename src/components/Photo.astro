---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /**
   * Crop to a band. Portrait phone photographs otherwise run 700px tall and
   * push the actual content of a landing page below the fold.
   */
  ratio?: string;
  /** Where the crop favours, when a ratio is set. Defaults to the centre. */
  position?: string;
  class?: string;
}
const { src, alt, ratio, position, class: className = '' } = Astro.props;

// Never upscaled past its own size.
const maxW = Math.min(src.width, 900);
---
<figure class:list={['not-prose', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[Math.round(maxW / 2), maxW]}
    sizes={`(max-width: 700px) 100vw, ${maxW}px`}
    loading="lazy"
    decoding="async"
    class:list={[
      'w-full rounded-3xl border border-line bg-surface-2',
      ratio ? 'object-cover' : '',
    ]}
    style={ratio ? `aspect-ratio:${ratio}${position ? `;object-position:${position}` : ''}` : undefined}
  />
</figure>
