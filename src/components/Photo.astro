---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className = '' } = Astro.props;

// Deliberately smaller than the text measure. These illustrate the argument,
// they are not the subject, and a photograph running the full column width
// starts to read as a photo essay. Never upscaled past its own size.
const maxW = Math.min(src.width, 560);
---
<figure class:list={['not-prose', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[Math.round(maxW / 2), maxW]}
    sizes={`(max-width: 700px) 100vw, ${maxW}px`}
    loading="lazy"
    decoding="async"
    class="w-full rounded-3xl border border-line bg-surface-2"
    style={`max-width:${maxW}px`}
  />
</figure>
