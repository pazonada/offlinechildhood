---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Diameter in px. */
  size?: number;
  /** Which part of the photograph the frame keeps, e.g. '50% 35%'. */
  position?: string;
  /**
   * Width-to-height ratio. Omit for the usual circle. Set it (1.6 and up) for a
   * landscape band, which is the only way to show the full width of a photograph
   * where the subject runs corner to corner.
   */
  ratio?: number;
  class?: string;
}
const {
  src,
  alt,
  size = 340,
  position = '50% 50%',
  ratio,
  class: className = '',
} = Astro.props;

const band = typeof ratio === 'number';
// `size` is the diameter for a circle and the width for a band.
const height = band ? Math.round(size / ratio!) : size;
// The traced line sits outside the photograph, so the figure needs room for it.
// Scaled off the short side, or a wide band gets an absurdly thick margin.
const pad = Math.round(Math.min(size, height) * 0.055);
---
<figure
  class:list={['not-prose relative mx-auto', className]}
  style={`width:${size + pad * 2}px;max-width:100%`}
>
  <div class="relative w-full" style={band ? `aspect-ratio:${ratio}` : 'aspect-ratio:1'}>
    <Image
      src={src}
      alt={alt}
      widths={[size, size * 2]}
      sizes={`${size}px`}
      loading="lazy"
      decoding="async"
      class:list={['absolute object-cover', band ? 'rounded-[1.75rem]' : 'rounded-full']}
      style={`inset:${pad}px;width:calc(100% - ${pad * 2}px);height:calc(100% - ${pad * 2}px);object-position:${position}`}
    />

    {/* Drawn rather than a border: the radii vary, the line overshoots where it
        closes, and it does not quite meet itself, the way a traced circle
        never does. */}
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full"
      viewBox={band ? '0 0 160 100' : '0 0 100 100'}
      preserveAspectRatio="none"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d={band
          ? 'M12.4 4.4C42 3.4 92 3.8 147.6 4.9c4.6.1 8.2 2.7 8.3 7.3.5 23.4-.3 56.4-.7 77.2-.1 4.6-3.2 7.2-7.9 7.3-38.4.9-93.6.3-135.2-.3-4.8-.1-8-3-8.2-7.6-.8-26.6-.4-56.8.2-76.6.1-4.8 3-7.7 7.7-7.8 12.6-.3 27.4-.1 41.2.2'
          : 'M51.2 2.6C77 3.4 97.1 24.6 97.4 50.6c.3 25.8-20.4 46.6-46.2 46.8C25.6 97.6 4.2 77.2 3.4 51.4 2.6 25.8 23.4 3.6 49.2 2.6c9.4-.4 18.6 2 26.4 6.8'}
        stroke="var(--ink)"
        stroke-width={band ? 0.62 : 0.9}
        stroke-linecap="round"
        vector-effect={band ? 'non-scaling-stroke' : undefined}
        opacity="0.85"
      />
    </svg>
  </div>
</figure>
