---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Diameter in px. */
  size?: number;
  /** Which part of the photograph the circle keeps, e.g. '50% 35%'. */
  position?: string;
  class?: string;
}
const { src, alt, size = 340, position = '50% 50%', class: className = '' } = Astro.props;

// The traced ring sits outside the photograph, so the figure needs room for it.
const pad = Math.round(size * 0.055);
---
<figure
  class:list={['not-prose relative mx-auto', className]}
  style={`width:${size + pad * 2}px;max-width:100%`}
>
  <div class="relative aspect-square w-full">
    <Image
      src={src}
      alt={alt}
      widths={[size, size * 2]}
      sizes={`${size}px`}
      loading="lazy"
      decoding="async"
      class="absolute rounded-full object-cover"
      style={`inset:${pad}px;width:calc(100% - ${pad * 2}px);height:calc(100% - ${pad * 2}px);object-position:${position}`}
    />

    {/* Drawn rather than a border: the radii vary, the line overshoots where it
        closes, and it does not quite meet itself, the way a traced circle
        never does. */}
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full"
      viewBox="0 0 100 100"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M51.2 2.6C77 3.4 97.1 24.6 97.4 50.6c.3 25.8-20.4 46.6-46.2 46.8C25.6 97.6 4.2 77.2 3.4 51.4 2.6 25.8 23.4 3.6 49.2 2.6c9.4-.4 18.6 2 26.4 6.8"
        stroke="var(--ink)"
        stroke-width="0.9"
        stroke-linecap="round"
        opacity="0.85"
      />
    </svg>
  </div>
</figure>
