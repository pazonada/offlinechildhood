---
import { SOURCES } from '../lib/sources';

interface Props {
  ids: string[];
}
const { ids } = Astro.props;
const cited = ids.map((id) => SOURCES[id as keyof typeof SOURCES]).filter(Boolean);
---
{cited.length > 0 && (
  <section class="mt-16 border-t border-line pt-10" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="font-display text-sm font-bold uppercase tracking-[0.14em] text-ink-soft">
      Where this comes from
    </h2>
    <ol class="mt-5 grid gap-4">
      {cited.map((s) => (
        <li class="text-[0.95rem] leading-relaxed">
          <a
            href={s.url}
            target="_blank"
            rel="noopener"
            class="font-semibold text-primary-text underline underline-offset-4 hover:text-ink"
          >
            {s.authors}, {s.venue}, {s.year}
          </a>
          {s.contested && (
            <span class="ml-2 rounded-full border border-line px-2 py-0.5 text-xs font-semibold text-ink-soft">
              Disputed
            </span>
          )}
          <p class="mt-1 text-ink-soft">{s.claim}</p>
        </li>
      ))}
    </ol>
  </section>
)}
