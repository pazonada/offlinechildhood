---
import { SOURCES } from '../lib/sources';

interface Props {
  ids: string[];
}
const { ids } = Astro.props;
const cited = ids.map((id) => SOURCES[id as keyof typeof SOURCES]).filter(Boolean);
---

{/* Numbered footnotes in small gray at the very bottom of the page, so the
    receipts are checkable without reading as a section of the argument. */}
{cited.length > 0 && (
  <section aria-labeledby="sources-heading">
    <h2 id="sources-heading" class="mb-4 font-label text-[11px] font-bold uppercase tracking-[0.22em] text-ink-soft">
      Sources
    </h2>
    <ol class="flex flex-col gap-3.5">
      {cited.map((s, i) => (
        <li class="grid grid-cols-[22px_minmax(0,1fr)] gap-2.5">
          <span class="font-label text-[13px] font-bold text-ink-soft" aria-hidden="true">{i + 1}.</span>
          <p class="text-[0.9rem] leading-[1.6] text-ink-soft">
            {s.authors}.{' '}
            <a href={s.url} target="_blank" rel="noopener" class="text-ink-soft underline underline-offset-4 hover:text-ink">{s.title}</a>.{' '}
            {s.venue}, {s.year}.
            {s.contested && (
              <span class="mx-1 rounded-full border border-line-dark px-2 py-0.5 text-xs font-semibold">Disputed</span>
            )}{' '}
            {s.claim}
          </p>
        </li>
      ))}
    </ol>
  </section>
)}
