---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a
  href={href}
  class="no-print group inline-flex items-center gap-1.5 text-sm font-bold text-ink-soft transition hover:text-ink"
>
  <span aria-hidden="true" class="inline-block transition group-hover:-translate-x-1">&larr;</span>
  {label}
</a>
