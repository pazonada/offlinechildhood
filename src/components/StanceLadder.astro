---
import type { StanceId } from '../content.config';

interface Stance {
  id: StanceId;
  label: string;
  summary: string;
  forFamiliesWho: string;
}
interface Props {
  stances: Stance[];
}
const { stances } = Astro.props;
---

{/* Labeled rows on hairlines, no cards, and no rule above the first row.
    The rungs still read top to bottom as a ladder. */}
<section aria-label="Three ways to do this" class="not-prose">
  <ol>
    {stances.map((s) => (
      <li class="grid gap-x-7 gap-y-2 border-b border-line-strong py-[26px] sm:grid-cols-[150px_minmax(0,1fr)]">
        <p class="font-label text-[13px] font-bold uppercase tracking-[0.14em] text-navy">
          {s.label}
        </p>
        <div>
          <p class="mb-2 text-lg leading-relaxed text-ink">{s.summary}</p>
          <p class="text-[1rem] leading-[1.55] text-primary-text">For families who {s.forFamiliesWho}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
