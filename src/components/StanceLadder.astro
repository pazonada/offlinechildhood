---
import type { StanceId } from '../content.config';

interface Stance {
  id: StanceId;
  label: string;
  summary: string;
  forFamiliesWho: string;
}
interface Props {
  stances: Stance[];
}
const { stances } = Astro.props;

const tone: Record<StanceId, string> = {
  start: 'border-accent/60 bg-accent/12',
  further: 'border-secondary/45 bg-secondary/10',
  allin: 'border-primary/50 bg-primary/10',
};
---

<section aria-labelledby="ladder-heading" class="not-prose">
  <h2 id="ladder-heading" class="font-display text-2xl font-extrabold">Three ways to do this</h2>
  <p class="mt-2 max-w-2xl text-ink-soft">
    These all point the same direction. They are rungs on a ladder rather than options on a menu, so
    start wherever you can actually hold the line. A rule you keep beats a rule you announce.
  </p>

  <ol class="mt-6 grid gap-4 md:grid-cols-3">
    {stances.map((s, i) => (
      <li class:list={['rounded-2xl border-2 p-5', tone[s.id]]}>
        <p class="flex items-center gap-2 font-display text-lg font-extrabold text-ink">
          <span
            class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-ink text-sm text-surface"
            aria-hidden="true"
          >{i + 1}</span>
          {s.label}
        </p>
        <p class="mt-3 text-[0.97rem] leading-relaxed text-ink">{s.summary}</p>
        <p class="mt-3 border-t border-line pt-3 text-sm text-ink-soft">
          For families who {s.forFamiliesWho}
        </p>
      </li>
    ))}
  </ol>
</section>
