---
import Container from './Container.astro';
import { footerNav } from '../lib/nav';
const year = new Date().getFullYear();

// Two right-pinned columns, five and six.
const colA = footerNav.slice(0, 5);
const colB = footerNav.slice(5);
---

<footer class="mt-[84px] bg-navy text-on-navy">
  <Container>
    <div class="flex flex-col justify-between gap-14 pb-11 pt-[62px] sm:flex-row sm:items-start">
      <div>
        <div class="mb-4 flex items-center gap-2.5">
          <svg aria-hidden="true" viewBox="0 0 64 64" class="h-[30px] w-[30px] shrink-0">
            <rect width="64" height="64" rx="17" fill="var(--primary)" />
            <circle cx="32" cy="32" r="10.5" fill="var(--accent)" />
            <g stroke="var(--on-primary)" stroke-width="3.4" stroke-linecap="round">
              <path d="M32 9v5.5M32 49.5V55M9 32h5.5M49.5 32H55M15.8 15.8l3.9 3.9M44.3 44.3l3.9 3.9M48.2 15.8l-3.9 3.9M19.7 44.3l-3.9 3.9" />
            </g>
          </svg>
          <span class="font-display text-[19px] font-extrabold tracking-tight text-on-navy-bright">
            Offline Childhood
          </span>
        </div>
        <p class="mb-4 max-w-[30em] text-[1.03rem] leading-relaxed text-on-navy-soft">
          Practical help for families who want less screen and more world, and who also want kids
          who can think clearly about the media they will grow up using.
        </p>
        <a
          href="mailto:hello@offlinechildhood.com"
          class="text-accent-light underline underline-offset-4"
        >
          hello@offlinechildhood.com
        </a>
      </div>

      {/* The two columns travel as one right-pinned group with a fixed gap. */}
      <nav aria-label="Footer" class="flex gap-[72px]">
        <ul class="flex flex-col gap-[11px] text-[0.97rem] sm:items-end sm:text-right">
          {colA.map((item) => (
            <li>
              <a href={item.href} class="text-on-navy transition hover:text-on-navy-bright hover:underline hover:underline-offset-4">{item.label}</a>
            </li>
          ))}
        </ul>
        <ul class="flex flex-col gap-[11px] text-[0.97rem] sm:items-end sm:text-right">
          {colB.map((item) => (
            <li>
              <a href={item.href} class="text-on-navy transition hover:text-on-navy-bright hover:underline hover:underline-offset-4">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-wrap justify-between gap-4 border-t border-on-navy/20 pb-10 pt-5 text-[0.94rem] text-on-navy-faint">
      <p>&copy; {year} Offline Childhood</p>
    </div>
  </Container>
</footer>
