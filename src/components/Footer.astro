---
import Container from './Container.astro';
import { footerNav } from '../lib/nav';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface-2">
  <Container>
    <div class="grid gap-10 py-14 md:grid-cols-[1.4fr_1fr]">
      <div class="max-w-md">
        <p class="font-display text-xl font-extrabold text-ink">Offline Childhood</p>
        <p class="mt-3 text-ink-soft">
          Practical help for families who want less screen and more world, and who also want kids
          who can think clearly about the media they will grow up using.
        </p>
        <a
          href="mailto:hello@offlinechildhood.com"
          class="mt-4 inline-block font-semibold text-primary-text underline underline-offset-4"
        >
          hello@offlinechildhood.com
        </a>
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft transition hover:text-ink">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-2 border-t border-line py-6 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Offline Childhood</p>
    </div>
  </Container>
</footer>
