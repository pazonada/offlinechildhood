---
interface Props {
  /** prose = reading width; wide = layout width; full = edge padding only */
  width?: 'prose' | 'wide' | 'full';
  class?: string;
}
const { width = 'wide', class: className = '' } = Astro.props;
const widths = {
  prose: 'max-w-[56rem]',
  wide: 'max-w-[80rem]',
  full: 'max-w-none',
};
---
<div class:list={['mx-auto w-full px-6 sm:px-10 lg:px-12', widths[width], className]}>
  <slot />
</div>
