---
import CategoryIcon from './CategoryIcon.astro';
import { TAG_STYLE, type PickTag } from '../lib/categories';

interface Props {
  name: string;
  maker: string;
  kind: 'Product' | 'Service';
  tags: PickTag[];
  summary: string;
  price?: string;
  url: string;
  limitations?: string;
}
const { name, maker, kind, tags, summary, price, url, limitations } = Astro.props;
const primaryTag = tags[0]!;
const style = TAG_STYLE[primaryTag];
---
<article
  class="not-prose flex flex-col rounded-[26px] border-2 border-line bg-surface px-6 pb-[22px] pt-6 transition hover:border-line-dark"
  data-kind={kind}
  data-tags={tags.join('|')}
>
  <div class="flex items-start gap-4">
    <span class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-2xl', style.tile]}>
      <CategoryIcon category={primaryTag} class="h-6 w-6" />
    </span>

    <div class="min-w-0 flex-1">
      <h3 class="text-balance font-display text-[19px] font-extrabold leading-[1.24] text-navy">{name}</h3>
      <p class:list={['mt-1.5 font-label text-[11px] font-bold uppercase tracking-[0.14em]', style.text]}>
        {primaryTag}
      </p>
    </div>
  </div>

  <p class="mt-4 leading-relaxed">{summary}</p>

  {/* Ink rather than a category color: the color coding means "this is a
      phones product", and price has nothing to do with category. */}
  {price && <p class="mt-3 font-semibold text-ink">{price}</p>}

  {limitations && (
    <p class="mt-4 rounded-[14px] bg-panel-blue px-4 py-3.5 text-[0.94rem] leading-[1.6] text-ink-soft">
      <span class="font-display font-extrabold text-ink">Downsides.</span> {limitations}
    </p>
  )}

  {tags.length > 1 && (
    <div class="mt-5 flex flex-wrap items-center gap-2">
      {tags.slice(1).map((t) => (
        <span class:list={['rounded-full px-[11px] py-[5px] text-[12.5px] font-semibold', TAG_STYLE[t].tile]}>
          {t}
        </span>
      ))}
    </div>
  )}

  <div class="mt-auto pt-[18px]">
    <div class="border-t border-line pt-4">
    <a
      href={url}
      rel="noopener"
      target="_blank"
      class="font-display font-bold text-primary-text underline underline-offset-4 hover:text-navy"
    >
      Visit {maker}
      <span class="sr-only">(opens in a new tab)</span>
    </a>
    </div>
  </div>
</article>
