---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  maker: string;
  summary: string;
  priceBand: string;
  url: string;
  affiliate: boolean;
  limitations?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { name, maker, summary, priceBand, url, affiliate, limitations, image, imageAlt } = Astro.props;

// Until a product has a photograph, a lettered tile keeps the row of cards
// even rather than leaving a ragged gap where an image should be.
const initials = maker
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---
<article class="not-prose flex flex-col rounded-2xl border border-line bg-surface-2 p-5">
  <div class="flex items-start gap-4">
    {image ? (
      <Image
        src={image}
        alt={imageAlt ?? name}
        width={112}
        height={112}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="h-16 w-16 shrink-0 rounded-xl border border-line bg-surface object-contain p-1.5"
      />
    ) : (
      <span
        class="grid h-16 w-16 shrink-0 place-items-center rounded-xl border border-line bg-surface font-display text-xl font-extrabold text-ink-soft"
        aria-hidden="true"
      >{initials}</span>
    )}

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class="font-display text-lg font-extrabold text-ink">{name}</h3>
          <p class="text-sm text-ink-soft">{maker}</p>
        </div>
        <span
          class="shrink-0 rounded-full bg-surface-3 px-2.5 py-1 text-sm font-semibold text-ink-soft"
          aria-label={`Price band ${priceBand}`}
        >{priceBand}</span>
      </div>
    </div>
  </div>

  <p class="mt-4 text-[0.97rem] leading-relaxed">{summary}</p>

  {limitations && (
    <p class="mt-3 rounded-xl bg-surface px-3.5 py-3 text-sm text-ink-soft">
      <span class="font-semibold text-ink">What it isn't good at.</span> {limitations}
    </p>
  )}

  <div class="mt-4 flex items-center justify-between gap-3 pt-1">
    <a
      href={url}
      rel={affiliate ? 'sponsored noopener' : 'noopener'}
      target="_blank"
      class="font-display font-bold text-primary-text underline underline-offset-4 hover:text-ink"
    >
      Visit {maker}
      <span class="sr-only">(opens in a new tab)</span>
    </a>
    {affiliate && (
      <span class="rounded-full border border-line px-2.5 py-1 text-xs font-semibold text-ink-soft">
        Paid link
      </span>
    )}
  </div>
</article>
