---
import CategoryIcon from './CategoryIcon.astro';
import { TAG_STYLE, PRICE_LEVEL, type PickTag } from '../lib/categories';

interface Props {
  name: string;
  maker: string;
  kind: 'Product' | 'Service';
  tags: PickTag[];
  summary: string;
  priceBand: string;
  price?: string;
  url: string;
  limitations?: string;
}
const { name, maker, kind, tags, summary, priceBand, price, url, limitations } = Astro.props;
const primaryTag = tags[0]!;
const style = TAG_STYLE[primaryTag];
const level = PRICE_LEVEL[priceBand] ?? 1;
---
<article
  class="not-prose flex flex-col rounded-3xl border-2 border-line bg-surface p-6 transition hover:border-ink/25"
  data-kind={kind}
  data-tags={tags.join('|')}
>
  <div class="flex items-start gap-4">
    <span class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-2xl', style.tile]}>
      <CategoryIcon category={primaryTag} class="h-6 w-6" />
    </span>

    <div class="min-w-0 flex-1">
      <h3 class="font-display text-lg font-extrabold leading-tight text-ink">{name}</h3>
    </div>

    <span class="flex shrink-0 items-center gap-1 pt-1.5">
      <span class="sr-only">Price band {priceBand} out of $$$</span>
      {[1, 2, 3].map((i) => (
        <span
          class:list={['block h-2 w-2 rounded-full', i <= level ? style.dot : 'bg-line']}
          aria-hidden="true"
        ></span>
      ))}
    </span>
  </div>

  <p class="mt-4 leading-relaxed">{summary}</p>

  {price && <p class="mt-3 text-sm font-semibold text-ink-soft">{price}</p>}

  {limitations && (
    <p class="mt-4 rounded-xl bg-surface-2 px-4 py-3 text-sm leading-relaxed text-ink-soft">
      <span class="font-display font-bold text-ink">Downsides.</span> {limitations}
    </p>
  )}

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
    {tags.map((t) => (
      <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', TAG_STYLE[t].tile]}>
        {t}
      </span>
    ))}
  </div>

  <div class="mt-4 border-t border-line pt-4">
    <a
      href={url}
      rel="noopener"
      target="_blank"
      class:list={['font-display font-bold underline underline-offset-4 hover:text-ink', style.text]}
    >
      Visit {maker}
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </div>
</article>
