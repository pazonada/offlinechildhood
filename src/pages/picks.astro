---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import PickCard from '../components/PickCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { TAG_STYLE, type PickTag } from '../lib/categories';

const picks = (await getCollection('picks')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const products = picks.filter((p) => p.data.kind === 'Product');
const services = picks.filter((p) => p.data.kind === 'Service');

// Only offer filters for tags that actually have something behind them.
const tagCounts = new Map<PickTag, number>();
for (const p of picks) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base
  title="What to buy"
  description="Products and services worth considering, with what each one is bad at stated plainly. Nothing here pays us."
>
  <header class="border-b border-line bg-surface-2 py-16 sm:py-20">
    <Container>
      <div class="grid items-start gap-x-14 gap-y-5 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <h1 class="text-4xl font-extrabold sm:text-5xl">What to buy</h1>
        <p class="text-lg text-ink-soft md:mt-2">
          Every entry says what it is bad at, because a recommendation with no stated downside is an
          advert. Nothing here pays us, and the honest answer is usually that you do not need to buy
          anything. Work out what you want to do in{' '}
          <a href="/decisions" class="font-semibold text-primary-text underline underline-offset-4">Decisions</a>{' '}
          first.
        </p>
      </div>
    </Container>
  </header>

  <Container class="py-12">
    {/* Multi-select filter. Built on <details> so it opens and closes without
        JavaScript, and every card stays visible if the script never runs. */}
    <details class="no-print relative w-full max-w-sm" id="filter">
      <summary
        class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-2.5 text-ink-soft transition hover:border-ink/30"
      >
        <span>
          Categories
          <span id="filter-label" class="text-ink">All</span>
        </span>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>

      <div class="absolute left-0 top-full z-30 mt-2 w-full rounded-xl border border-line bg-surface p-2 shadow-lg shadow-ink/5">
        <ul class="grid gap-0.5">
          {tags.map(([tag, count]) => (
            <li>
              <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-2 hover:bg-surface-2">
                <input type="checkbox" value={tag} class="filter-check h-4 w-4 rounded border-line accent-primary" />
                <span class:list={['grid h-6 w-6 shrink-0 place-items-center rounded-md', TAG_STYLE[tag].tile]}>
                  <CategoryIcon category={tag} class="h-3.5 w-3.5" />
                </span>
                <span class="flex-1 text-[0.95rem]">{tag}</span>
                <span class="text-sm text-ink-soft">{count}</span>
              </label>
            </li>
          ))}
        </ul>
        <div class="mt-1 border-t border-line pt-1">
          <button
            type="button"
            id="filter-clear"
            class="w-full rounded-lg px-2.5 py-2 text-left text-[0.95rem] text-ink-soft hover:bg-surface-2 hover:text-ink"
          >
            Clear all
          </button>
        </div>
      </div>
    </details>
    <p id="filter-status" class="no-print mt-3 text-sm text-ink-soft" role="status" aria-live="polite"></p>

    {[
      { title: 'Products', blurb: 'Things you buy once.', items: products },
      { title: 'Services', blurb: 'Things you subscribe to or book.', items: services },
    ].map((group) => (
      <section class="mt-14" data-group={group.title}>
        <div class="flex items-baseline gap-3">
          <h2 class="font-display text-2xl font-extrabold">{group.title}</h2>
          <span class="text-ink-soft">{group.blurb}</span>
          <span class="h-0.5 flex-1 rounded-full bg-line" aria-hidden="true"></span>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {group.items.map((p) => <PickCard {...p.data} />)}
        </div>
        <p class="mt-6 hidden text-ink-soft" data-empty>Nothing in this category.</p>
      </section>
    ))}
  </Container>
</Base>

<script>
  const root = document.getElementById('filter') as HTMLDetailsElement | null;
  const checks = Array.from(document.querySelectorAll<HTMLInputElement>('.filter-check'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('article[data-tags]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const label = document.getElementById('filter-label');
  const status = document.getElementById('filter-status');
  const clear = document.getElementById('filter-clear');

  function apply() {
    const chosen = checks.filter((c) => c.checked).map((c) => c.value);
    let shown = 0;

    cards.forEach((card) => {
      const tags = (card.dataset.tags ?? '').split('|');
      // No selection means no filter, rather than an empty page.
      const match = chosen.length === 0 || chosen.some((t) => tags.includes(t));
      card.hidden = !match;
      if (match) shown++;
    });

    // Collapse a section the filter has emptied, so no heading is left orphaned.
    groups.forEach((g) => {
      g.hidden = !Array.from(g.querySelectorAll<HTMLElement>('article[data-tags]')).some(
        (c) => !c.hidden,
      );
    });

    if (label) {
      label.textContent =
        chosen.length === 0 ? 'All' : chosen.length === 1 ? chosen[0]! : `${chosen.length} selected`;
    }
    if (status) {
      status.textContent =
        chosen.length === 0 ? '' : `Showing ${shown} of ${cards.length} entries.`;
    }
  }

  checks.forEach((c) => c.addEventListener('change', apply));
  clear?.addEventListener('click', () => {
    checks.forEach((c) => (c.checked = false));
    apply();
  });

  document.addEventListener('click', (e) => {
    if (root?.open && !root.contains(e.target as Node)) root.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root?.open) {
      root.open = false;
      root.querySelector('summary')?.focus();
    }
  });
</script>
