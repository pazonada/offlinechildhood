---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import PickCard from '../components/PickCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { CATEGORY_STYLE } from '../lib/categories';

const picks = await getCollection('picks');
const CATEGORIES = [
  'Phones and watches',
  'Audio and stories',
  'Cameras and making',
  'Games and play',
  'Books and paper',
  'Outdoor',
  'Software and settings',
] as const;

const grouped = CATEGORIES.map((category) => ({
  category,
  items: picks.filter((p) => p.data.category === category),
})).filter((g) => g.items.length > 0);
---

<Base
  title="What to buy"
  description="A short list of things worth owning, with what each one is bad at stated plainly. The honest answer to most of these questions is that you do not need to buy anything."
>
  {/* Wide container to match the card grid below. Using the prose width here
      left the heading centred to a different measure than its own content. */}
  <header class="border-b border-line bg-surface-2 py-16 sm:py-20">
    <Container>
      <div class="grid items-start gap-x-14 gap-y-5 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <h1 class="text-4xl font-extrabold sm:text-5xl">What to buy</h1>
        <p class="text-lg text-ink-soft md:mt-2">
          A short list, kept short on purpose. Every entry says what it is bad at, because a
          recommendation with no stated downside is an advert. Nothing here pays us, and the honest
          answer is usually that you do not need to buy anything. Work out what you want to do in{' '}
          <a href="/decisions" class="font-semibold text-primary-text underline underline-offset-4">Decisions</a>{' '}
          first.
        </p>
      </div>
    </Container>
  </header>

  <Container class="py-14">
    {grouped.map((group) => {
      const style = CATEGORY_STYLE[group.category];
      return (
        <section class="mb-16">
          <div class="flex items-center gap-3">
            <span class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-xl', style.tile]}>
              <CategoryIcon category={group.category} class="h-5 w-5" />
            </span>
            <h2 class:list={['font-display text-sm font-bold uppercase tracking-[0.14em]', style.text]}>
              {group.category}
            </h2>
            <span class:list={['h-0.5 flex-1 rounded-full', style.rule]} aria-hidden="true"></span>
            <span class="shrink-0 text-sm text-ink-soft">
              {group.items.length} {group.items.length === 1 ? 'pick' : 'picks'}
            </span>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((p) => <PickCard {...p.data} />)}
          </div>
        </section>
      );
    })}
  </Container>
</Base>
