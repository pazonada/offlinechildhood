---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';

const questions = (await getCollection('questions')).sort(
  (a, b) => b.data.updated.getTime() - a.data.updated.getTime(),
);
---

<Base
  title="Questions"
  description="Send us a situation you're navigating with your kids and screens, and read our answers to questions other readers have asked. Free, and nothing is published without editing out anything identifying."
>
  <header class="border-b border-line bg-surface-2 py-14">
    <Container>
      <div class="max-w-[46em]">
        <p class="mb-3.5 font-label text-xs font-bold uppercase tracking-[0.22em] text-primary-text">
          The advice column
        </p>
        <h1 class="font-display text-[clamp(38px,4vw,52px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
          Ask us
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Navigating a situation the site doesn't cover? A school policy, a grandparent with an
          iPad, a kid who found a loophole? Send it to us. We read everything, answer the
          questions other families are likely facing too, and publish those answers here with
          anything identifying edited out.
        </p>
      </div>
    </Container>
  </header>

  <div class="mx-auto w-full max-w-[900px] px-6 pb-24 pt-12 sm:px-10">
    <section class="rounded-[28px] border-2 border-accent bg-panel-accent px-9 pb-8 pt-[30px]">
      <h2 class="font-display text-[24px] font-extrabold text-navy">Send a question</h2>
      <p class="mt-2 text-[1.01rem] leading-[1.62] text-ink">
        Leave out names, schools, and anything that would identify your kid. If you include your
        email, we use it only to reply, and it is never published.
      </p>

      <form id="ask-form" class="mt-6 flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="ask-situation" class="text-sm font-semibold text-ink">The situation</label>
          <textarea
            id="ask-situation"
            name="situation"
            rows="5"
            maxlength="3000"
            required
            placeholder="What is happening, what you have tried, and what you are weighing."
            class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-3 text-[1rem] leading-[1.6] text-ink placeholder:text-ink-soft/70"
          ></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="ask-ages" class="text-sm font-semibold text-ink">Your kids' ages <span class="font-normal text-ink-soft">(optional)</span></label>
            <input
              id="ask-ages"
              name="ages"
              type="text"
              maxlength="100"
              placeholder="e.g. 6 and 9"
              class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="ask-email" class="text-sm font-semibold text-ink">Your email <span class="font-normal text-ink-soft">(optional, for a reply)</span></label>
            <input
              id="ask-email"
              name="email"
              type="email"
              maxlength="200"
              placeholder="you@example.com"
              class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
            />
          </div>
        </div>

        <button
          type="submit"
          class="self-start rounded-full bg-primary px-7 py-[13px] font-label text-[16px] font-bold text-on-navy-bright transition hover:bg-primary-strong"
        >
          Send it
        </button>
      </form>

      <p id="ask-ok" hidden class="mt-4 flex items-start gap-2 leading-relaxed text-green-deep">
        <svg viewBox="0 0 20 20" class="mt-1 h-[17px] w-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg>
        Thank you. We read every question, and if yours gets published, it will be anonymized
        first.
      </p>
      <p id="ask-err" hidden class="mt-4 leading-relaxed text-coral" role="alert">
        That did not send. Please try again, or email{' '}
        <a href="mailto:hello@offlinechildhood.com" class="underline underline-offset-4">hello@offlinechildhood.com</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="sun-heading mb-2 font-display text-[33px] font-extrabold leading-[1.14] text-navy">
        Answered so far
      </h2>

      {questions.length === 0 ? (
        <p class="mt-4 max-w-[40em] text-[1.06rem] leading-[1.7] text-ink-soft">
          This column is brand new, so the first answers are still being written. Send a question
          above and help us start it.
        </p>
      ) : (
        <ul class="mt-6 flex flex-col gap-0.5">
          {questions.map((q) => (
            <li class="border-b border-line py-6">
              <p class="mb-2 font-label text-[11.5px] font-bold uppercase tracking-[0.2em] text-ink-soft">
                {q.data.asker}
              </p>
              <a
                href={`/questions/${q.id}`}
                class="text-balance text-[22px] font-semibold leading-[1.32] text-primary-text underline decoration-panel-blue-line-strong decoration-[1.5px] underline-offset-4 transition hover:decoration-primary"
              >
                {q.data.question}
              </a>
              <p class="mt-2.5 max-w-[44em] text-[1rem] leading-relaxed text-ink-soft">{q.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
    <section class="mt-16 rounded-[28px] border-[1.5px] border-panel-blue-line bg-panel-blue px-9 pb-8 pt-[30px]">
      <h2 class="font-display text-[24px] font-extrabold text-navy">Or talk it over with other parents</h2>
      <p class="mt-2.5 max-w-[44em] text-[1.03rem] leading-[1.7] text-ink">
        Some situations want a conversation more than a column. We just opened{' '}
        <a
          href="https://www.reddit.com/r/OfflineChildhood/"
          target="_blank"
          rel="noopener"
          class="font-semibold text-primary-text underline underline-offset-4 hover:text-navy"
        >r/OfflineChildhood</a>{' '}
        for exactly that. It is brand new, which means the first families there get to set its
        tone. Same rules as here: no names, no photos of kids, nothing identifying.
      </p>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  const ok = document.getElementById('ask-ok');
  const err = document.getElementById('ask-err');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const payload = {
      situation: String(data.get('situation') ?? ''),
      ages: String(data.get('ages') ?? ''),
      email: String(data.get('email') ?? ''),
    };
    if (!payload.situation.trim()) return;

    if (ok) ok.hidden = true;
    if (err) err.hidden = true;

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.hidden = true;
      if (ok) ok.hidden = false;
    } catch {
      if (err) err.hidden = false;
    }
  });
</script>
