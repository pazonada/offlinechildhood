---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="That page does not exist. Here is where everything lives now.">
  <Container width="prose" class="py-20 sm:py-28">
    <p class="font-display text-sm font-bold uppercase tracking-[0.14em] text-primary-text">404</p>
    <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">That page isn't here</h1>
    <p class="mt-5 text-lg text-ink-soft">
      We rebuilt this site from scratch, so a few old links no longer have a home. Nothing is lost.
      Here is where everything lives now.
    </p>

    <ul class="mt-10 grid gap-4">
      <li>
        <a href="/decisions" class="block rounded-2xl border-2 border-line bg-surface-2 p-6 transition hover:border-primary">
          <span class="font-display text-xl font-extrabold text-ink">Decisions</span>
          <span class="mt-1 block text-ink-soft">
            The device calls: the first phone, tablets, games, what happens at bedtime.
          </span>
        </a>
      </li>
      <li>
        <a href="/conversations" class="block rounded-2xl border-2 border-line bg-surface-2 p-6 transition hover:border-secondary">
          <span class="font-display text-xl font-extrabold text-ink">Conversations</span>
          <span class="mt-1 block text-ink-soft">
            How to explain algorithms, AI and the rest to a kid, at every age from four up.
          </span>
        </a>
      </li>
      <li>
        <a href="/picks" class="block rounded-2xl border-2 border-line bg-surface-2 p-6 transition hover:border-primary">
          <span class="font-display text-xl font-extrabold text-ink">What to buy</span>
          <span class="mt-1 block text-ink-soft">
            The old product directory lives here now, shorter and more honest.
          </span>
        </a>
      </li>
    </ul>

    <p class="mt-10 text-ink-soft">
      Looking for something specific that used to be here? Tell us at{' '}
      <a href="mailto:hello@offlinechildhood.com" class="font-semibold text-primary-text underline underline-offset-4">
        hello@offlinechildhood.com
      </a>{' '}
      and we will point you to it.
    </p>

    <Button href="/" variant="primary" class="mt-8">Back to the start</Button>
  </Container>
</Base>
