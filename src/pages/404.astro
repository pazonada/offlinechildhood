---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';

const destinations = [
  {
    href: '/decisions',
    title: 'Decisions',
    blurb: 'The device calls: the first phone, tablets, games, what happens at bedtime.',
    hover: 'hover:border-primary',
  },
  {
    href: '/conversations',
    title: 'Conversations',
    blurb: 'How to explain algorithms, AI and the rest to a kid, at every age from four and up.',
    hover: 'hover:border-accent',
  },
  {
    href: '/picks',
    title: 'What to buy',
    blurb: 'Products and services that help kids stay a little less digitally entrenched.',
    hover: 'hover:border-primary',
  },
];
---

<Base title="Page not found" description="That page does not exist. Here is where everything lives now." noSearchIndex={true}>
  <main class="mx-auto w-full max-w-[900px] px-6 pt-[72px] sm:px-10">
    <div class="grid items-start gap-x-12 gap-y-8 sm:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <p class="mb-3.5 font-label text-xs font-bold uppercase tracking-[0.22em] text-primary-text">404</p>
        <h1 class="text-balance font-display text-[clamp(36px,4vw,50px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
          That page isn't here
        </h1>
        <p class="mt-6 max-w-[34em] text-[1.1rem] leading-[1.68] text-ink-soft">
          Sorry, we weren't able to find the page you're looking for. Here's where you can go:
        </p>
      </div>

      {/* The big sun. Slower spin and a bigger swing than the heading suns. */}
      <svg
        viewBox="0 0 26 26"
        class="big-sun mt-1.5 hidden h-32 w-32 shrink-0 sm:block"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="13" cy="13" r="4.6" fill="var(--accent)" />
        <g stroke="var(--navy)" stroke-width="1.6" stroke-linecap="round">
          <path d="M13 1.6v3.4M13 21v3.4M24.4 13H21M5 13H1.6M21.1 4.9l-2.4 2.4M7.3 18.7l-2.4 2.4M21.1 21.1l-2.4-2.4M7.3 7.3L4.9 4.9" />
        </g>
      </svg>
    </div>

    <ul class="mt-11 flex flex-col gap-4">
      {destinations.map((d) => (
        <li>
          <a
            href={d.href}
            class:list={['block rounded-[22px] border-2 border-line bg-surface px-7 py-6 transition', d.hover]}
          >
            <span class="block font-display text-[21px] font-extrabold text-navy">{d.title}</span>
            <span class="mt-1.5 block text-[1.03rem] leading-relaxed text-ink-soft">{d.blurb}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-10 max-w-[34em] text-[1.06rem] leading-[1.68] text-ink-soft">
      Looking for something specific that used to be here? Tell us at{' '}
      <a href="mailto:hello@offlinechildhood.com" class="font-semibold text-primary-text underline underline-offset-4">
        hello@offlinechildhood.com
      </a>{' '}
      and we will point you to it.
    </p>

    <Button href="/" variant="primary" size="lg" class="mt-8">Back to the start</Button>
  </main>
</Base>

<style>
  .big-sun {
    transition: transform 0.6s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .big-sun:hover {
    transform: rotate(45deg);
  }
</style>
