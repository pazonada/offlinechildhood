---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import { SOURCES } from '../lib/sources';
import Scribble from '../components/Scribble.astro';
import Photo from '../components/Photo.astro';
import stamping from '../assets/photos/stamping.jpg';

const decisions = (await getCollection('decisions')).sort((a, b) => a.data.order - b.data.order);
const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);

const evidence = [
  {
    stat: 'Paper beats screen',
    body: 'Across 39 studies of about 1,800 young children, comprehension was lower from a digital book than from the same book on paper.',
    source: SOURCES.readingPaperMeta,
  },
  {
    stat: 'It is the portable ones',
    body: 'When researchers asked which screens actually cost children sleep, the answer was the devices that follow a kid into the bedroom.',
    source: SOURCES.sleepPortableDevices,
  },
  {
    stat: 'Play compounds',
    body: 'Unstructured free play in the early years predicted stronger self-regulation years later, and that capacity tracks with outcomes across a lifetime.',
    source: SOURCES.freePlaySelfRegulation,
  },
];
---

<Base
  title="Offline Childhood"
  bareTitle={true}
  description="A growing movement toward more analog ways of living, plus the media literacy adults and kids need to understand how these technologies work, who owns the platforms, and how to navigate them safely."
>
  <section class="relative overflow-hidden border-b border-line bg-surface-2">
    <div class="pointer-events-none absolute -right-24 -top-28 h-96 w-96 rounded-full bg-accent/30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-primary/15 blur-3xl" aria-hidden="true"></div>

    <Container class="relative py-20 sm:py-28">
      <div class="max-w-3xl">
        <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-primary-text">
          For parents and teachers
        </p>
        <h1 class="mt-4 text-5xl font-extrabold leading-[1.05] sm:text-6xl lg:text-7xl">
          Childhood in the{' '}
          <span class="relative whitespace-nowrap">
            <span class="relative z-10">real world</span>
            <span class="absolute inset-x-0 bottom-1.5 z-0 h-4 rounded-sm bg-accent sm:h-5" aria-hidden="true"></span>
          </span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink sm:text-xl">
          Our culture is saturated with screens, but there's a growing movement toward more analog
          ways of living: more play, more paper, more outside time. And because technology is
          unavoidable for this generation, media literacy is critical for adults and kids to
          understand how these technologies actually work, who owns the platforms, and how to
          navigate them safely and responsibly.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/plan" variant="primary" size="lg">Build your family plan</Button>
          <Button href="/decisions" variant="ghost" size="lg">Start with the decisions</Button>
        </div>
        <p class="mt-5 text-ink-soft">Free, no sign-up, and yours to print.</p>
      </div>
    </Container>
  </section>

  <Container class="py-20">
    <div class="grid gap-6 lg:grid-cols-2">
      <a href="/decisions" class="group rounded-3xl border-2 border-line bg-surface p-8 transition hover:border-primary hover:bg-surface-2">
        <span class="inline-grid h-12 w-12 place-items-center rounded-2xl bg-primary text-on-primary" aria-hidden="true">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v6M12 21v-6" /><path d="m7 9-4 3 4 3" /><path d="m17 9 4 3-4 3" /><path d="M3 12h18" />
          </svg>
        </span>
        <h2 class="mt-5 font-display text-3xl font-extrabold">Decisions</h2>
        <p class="mt-3 text-lg text-ink-soft">
          The calls that shape a childhood: the first phone, the tablet, the bedroom at night. Each
          one gets a straight answer and three ways to act on it, so you can start where you are.
        </p>
        <p class="mt-5 font-display font-bold text-primary-text">
          {decisions.length} {decisions.length === 1 ? 'decision' : 'decisions'}
          <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&nbsp;&rarr;</span>
        </p>
      </a>

      <a href="/conversations" class="group rounded-3xl border-2 border-line bg-surface p-8 transition hover:border-secondary hover:bg-surface-2">
        <span class="inline-grid h-12 w-12 place-items-center rounded-2xl bg-secondary text-on-secondary" aria-hidden="true">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z" /><path d="M9 11h6M9 15h3" />
          </svg>
        </span>
        <h2 class="mt-5 font-display text-3xl font-extrabold">Conversations</h2>
        <p class="mt-3 text-lg text-ink-soft">
          What an algorithm is. Where AI got its material. Who pays for the feed. Every idea written
          four times over, for ages 4 to 6, 7 to 9, 10 to 12, and 13 and up.
        </p>
        <p class="mt-5 font-display font-bold text-secondary-deep">
          {concepts.length} {concepts.length === 1 ? 'conversation' : 'conversations'}
          <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&nbsp;&rarr;</span>
        </p>
      </a>
    </div>
  </Container>

  <section class="border-y border-line bg-surface-2 py-20">
    <Container>
      {/* Heading and standfirst sit side by side so the row is actually used.
          A single column pinned left would leave a third of the width empty,
          and stretching the paragraph across the full width would push the
          line length past comfortable reading. */}
      <div class="grid items-center gap-x-12 gap-y-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div>
          <h2 class="relative inline-block font-display text-3xl font-extrabold text-balance sm:text-4xl">
            We argue from what a childhood gains
            <Scribble type="underline-double" class="absolute -bottom-4 left-0 h-3 w-full" />
          </h2>
          <p class="mt-9 text-lg text-ink-soft">
          Whether phones are behind the rise in teenage anxiety is still disputed among
          researchers, and we will not pretend otherwise. We do not need that argument. The case for
          analog stands on firmer ground, starting with arithmetic: an hour on a screen is an
            hour not spent on something else.
          </p>
        </div>

        <Photo
          src={stamping}
          alt="A child seen from above, pressing halved apples and onions into trays of blue and yellow paint."
          position="50% 42%"
          size={320}
        />
      </div>


      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {evidence.map((e) => (
          <li class="rounded-3xl border border-line bg-surface p-6">
            <p class="font-display text-xl font-extrabold text-ink">{e.stat}</p>
            <p class="mt-3 leading-relaxed text-ink-soft">{e.body}</p>
            <a
              href={e.source.url}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-block text-sm font-semibold text-primary-text underline underline-offset-4"
            >
              {e.source.authors}, {e.source.venue}, {e.source.year}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <Container class="py-20">
    <div class="rounded-3xl border-2 border-primary bg-primary/12 p-8 text-center sm:p-14">
      <h2 class="font-display text-3xl font-extrabold sm:text-4xl">Not sure where to start?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ink">
        Answer a few questions about your kids and get a plan you can stick on the fridge. It takes
        about three minutes, and we do not ask for your email to give it to you.
      </p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <Scribble type="arrow" class="hidden h-10 w-20 shrink-0 sm:block" color="var(--primary)" />
        <Button href="/plan" variant="primary" size="lg">Build your family plan</Button>
      </div>
    </div>
  </Container>
</Base>
