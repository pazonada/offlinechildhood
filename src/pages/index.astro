---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import { SOURCES } from '../lib/sources';
import Scribble from '../components/Scribble.astro';
import stamping from '../assets/photos/stamping.jpg';
import forestPath from '../assets/photos/jens-lelie-u0vgcIOQG08-unsplash.jpg';
import kidsTalking from '../assets/photos/vitaly-gariev-sbHo9rRSIZc-unsplash.jpg';
import robot from '../assets/photos/robot.jpg';

const decisions = (await getCollection('decisions')).sort((a, b) => a.data.order - b.data.order);
const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);

const evidence = [
  {
    stat: 'Paper beats screen',
    body: 'Across 39 studies of about 1,800 young children, comprehension was lower from a digital book than from the same book on paper.',
    source: SOURCES.readingPaperMeta,
    rule: 'border-accent',
  },
  {
    stat: 'It is the portable ones',
    body: 'When researchers asked which screens actually cost children sleep, the answer was the devices that follow a kid into the bedroom.',
    source: SOURCES.sleepPortableDevices,
    rule: 'border-primary',
  },
  {
    stat: 'Play compounds',
    body: 'Unstructured free play in the early years predicted stronger self-regulation years later, and that capacity tracks with outcomes across a lifetime.',
    source: SOURCES.freePlaySelfRegulation,
    rule: 'border-leaf',
  },
];
---

<Base
  title="Offline Childhood · See through the screen"
  bareTitle={true}
  ogTitle="Raising kids who love the real world, while empowering them to understand how machines have become a part of it."
  ogDescription="Straight answers to the big device decisions, and ways to explain AI and algorithms to kids at every age. Free, no sign-up, yours to print."
  description="Raising kids who love the real world, while empowering them to understand how machines have become a part of it."
>
  {/* Full-bleed blue hero. The headline never wraps: it shrinks via clamp and
      centers itself with width:max-content, which is what keeps it true-centred
      at every viewport. */}
  <section class="relative overflow-hidden bg-primary">
    <svg
      viewBox="0 0 1200 200"
      preserveAspectRatio="none"
      class="absolute inset-x-0 bottom-0 h-[200px] w-full"
      aria-hidden="true"
    >
      <path
        d="M0 200c98-52 190-24 292-78 86-46 174-6 256-48 74-36 168-20 240 18 68 36 174 48 230 18 48-28 128-32 182-12v102H0z"
        fill="var(--primary-strong)"
      />
    </svg>

    <Container class="relative pb-[76px] pt-[52px]">
      <div class="flex flex-col items-center text-center">
        <svg viewBox="0 0 260 260" class="mb-5 w-[78px]" aria-hidden="true">
          <circle cx="130" cy="130" r="62" fill="var(--accent)" />
          <g stroke="var(--page)" stroke-width="13" stroke-linecap="round">
            <path d="M130 44V14M130 216v30M216 130h30M14 130h30M191 69l21-21M48 212l21-21M191 191l21 21M48 48l21 21" />
          </g>
        </svg>

        <p class="mb-3.5 font-label text-xs font-bold uppercase tracking-[0.22em] text-accent-light">
          For parents and teachers
        </p>
        <h1 class="mx-auto w-max max-w-full whitespace-nowrap font-display text-[clamp(26px,3.5vw,56px)] font-extrabold leading-[1.1] tracking-[-0.015em] text-on-navy-bright">
          See through the{' '}
          <span class="relative inline-block">
            screen
            <Scribble type="underline" class="absolute -bottom-1.5 -left-1 h-3.5 w-[calc(100%+12px)]" color="var(--accent)" />
          </span>
        </h1>
        <p class="mx-auto mt-[22px] max-w-[36em] text-lg leading-relaxed text-on-primary-soft">
          Our culture is saturated with screens, but there's a growing movement toward more analog
          ways of living: more play, more paper, more outside time. And because technology is
          unavoidable for this generation, media literacy is critical for adults and kids to
          understand how these technologies actually work, who owns the platforms, and how to
          navigate them safely and responsibly.
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
          <Button href="/plan" variant="accent" size="lg">Build your family plan</Button>
          <Button href="/decisions" variant="outline-light" size="lg">Start with the decisions</Button>
        </div>
        <p class="mt-[18px] text-[15px] text-on-primary-faint">Free, no sign-up, and yours to print.</p>
      </div>
    </Container>
  </section>

  {/* The two pillars, each in an arched card. minmax(0,1fr) keeps the images
      from forcing their column wide and crushing the other. */}
  <Container class="pt-[74px]">
    <div class="grid gap-[34px] md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <a
        href="/decisions"
        class="group block rounded-[210px_32px_32px_32px] bg-surface-3 p-6 pb-10 transition hover:bg-card-cream-hover"
      >
        <div class="mb-7 overflow-hidden rounded-[190px_20px_20px_20px]">
          <Image
            src={forestPath}
            alt=""
            widths={[560, 1120]}
            sizes="(min-width: 768px) 540px, 92vw"
            class="h-[250px] w-full object-cover object-[50%_62%]"
          />
        </div>
        <h2 class="mb-3 px-[22px] font-display text-[32px] font-extrabold text-navy">Decisions</h2>
        <p class="mb-5 px-[22px] text-[1.03rem] leading-relaxed text-ink-soft">
          We make calls that shape a childhood: the first phone, the tablet, the level of access.
          Each decision gets a straight answer and three ways to act on it, so you can start where
          you are.
        </p>
        <span class="mx-[22px] inline-block font-label text-[13px] font-bold uppercase tracking-[0.06em] text-primary-text">
          {decisions.length} {decisions.length === 1 ? 'decision' : 'decisions'}
          <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&nbsp;&rarr;</span>
        </span>
      </a>

      <a
        href="/conversations"
        class="group block rounded-[32px_210px_32px_32px] bg-card-blue p-6 pb-10 transition hover:bg-card-blue-hover"
      >
        <div class="mb-7 overflow-hidden rounded-[20px_190px_20px_20px]">
          <Image
            src={kidsTalking}
            alt=""
            widths={[560, 1120]}
            sizes="(min-width: 768px) 540px, 92vw"
            class="h-[250px] w-full object-cover object-[42%_40%]"
          />
        </div>
        <h2 class="mb-3 px-[22px] font-display text-[32px] font-extrabold text-navy">Conversations</h2>
        <p class="mb-5 px-[22px] text-[1.03rem] leading-relaxed text-ink-soft">
          What's an algorithm? Where does AI get its material? Who pays for the feed? Every idea
          written four times over, for different ages.
        </p>
        <span class="mx-[22px] inline-block font-label text-[13px] font-bold uppercase tracking-[0.06em] text-primary-text">
          {concepts.length} {concepts.length === 1 ? 'conversation' : 'conversations'}
          <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&nbsp;&rarr;</span>
        </span>
      </a>
    </div>
  </Container>

  {/* The evidence section: standfirst beside the arched photograph, then the
      three findings on colored rules rather than cards. */}
  <Container class="pt-[84px]">
    <div class="grid items-start gap-x-[60px] gap-y-10 md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div>
        <h2 class="mb-[22px] font-display text-[clamp(34px,4vw,50px)] font-extrabold leading-[1.08] tracking-[-0.015em] text-navy">
          The benefits of reduced tech use are clear
        </h2>
        <p class="max-w-[32em] text-[1.1rem] leading-[1.68] text-ink-soft">
          Whether phones are behind the rise in teenage anxiety is still disputed among
          researchers, and we will not pretend otherwise. But the case for analog stands on firmer
          ground, starting with arithmetic: an hour on a screen is an hour not spent on something
          else.
        </p>
      </div>

      <div class="overflow-hidden rounded-[260px_260px_24px_24px] bg-surface-3">
        <Image
          src={stamping}
          alt="A child seen from above, pressing halved apples and onions into trays of blue and yellow paint."
          widths={[540, 1080]}
          sizes="(min-width: 768px) 520px, 92vw"
          class="h-[440px] w-full object-cover object-[50%_40%]"
        />
      </div>
    </div>

    <ul class="mt-[62px] grid gap-[30px] md:grid-cols-3">
      {evidence.map((e) => (
        <li class:list={['border-t-[3px] pt-6', e.rule]}>
          <p class="font-display text-2xl font-extrabold text-navy">{e.stat}</p>
          <p class="mt-3 leading-relaxed text-ink-soft">{e.body}</p>
          <a
            href={e.source.url}
            target="_blank"
            rel="noopener"
            class="mt-3.5 inline-block text-[0.9rem] leading-normal text-ink-soft underline underline-offset-4 hover:text-navy"
          >
            {e.source.authors}, {e.source.venue}, {e.source.year}
          </a>
        </li>
      ))}
    </ul>
  </Container>

  {/* The announcements list: one field, the owner's promise, Resend behind it. */}
  <Container class="mt-[86px]">
    <section id="updates" class="rounded-[28px] border-[1.5px] border-panel-blue-line bg-panel-blue px-9 pb-8 pt-[30px]">
      <h2 class="font-display text-[26px] font-extrabold text-navy">Hear when we publish something new</h2>
      <p class="mt-2.5 max-w-[46em] text-[1.03rem] leading-[1.7] text-ink">
        We understand too many emails are really, really annoying – even good ones. So we'll
        limit our communications to only important announcements, make unsubscribing easy, and
        if we grow enough to offer more frequent updates, you can opt in to those if you want.
      </p>
      <form id="updates-form" class="mt-5 flex max-w-[34rem] flex-wrap gap-3">
        <label for="updates-email" class="sr-only">Your email</label>
        <input
          id="updates-email"
          name="email"
          type="email"
          required
          maxlength="200"
          placeholder="you@example.com"
          class="min-w-[16rem] flex-1 rounded-xl border-[1.5px] border-panel-blue-line-strong bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
        />
        <button
          type="submit"
          class="rounded-full bg-primary px-6 py-[11px] font-label text-[15px] font-bold text-on-navy-bright transition hover:bg-primary-strong"
        >
          Sign me up
        </button>
      </form>
      <p id="updates-ok" hidden class="mt-3.5 flex items-start gap-2 leading-relaxed text-green-deep">
        <svg viewBox="0 0 20 20" class="mt-1 h-[17px] w-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg>
        You're on the list. Thank you.
      </p>
      <p id="updates-err" hidden class="mt-3.5 leading-relaxed text-coral" role="alert">
        That did not work. Please try again, or email{' '}
        <a href="mailto:hello@offlinechildhood.com" class="underline underline-offset-4">hello@offlinechildhood.com</a>.
      </p>
    </section>
  </Container>

  {/* Closing panel: photograph left in its arch, the plan invitation right. */}
  <Container class="mt-[86px]">
    <div class="grid items-center gap-11 rounded-[40px] bg-surface-3 p-6 md:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)]">
      <div class="overflow-hidden rounded-[28px_28px_190px_28px]">
        <Image
          src={robot}
          alt="A child holds a magnifying glass up to the face of a robot built from cardboard boxes, painted purple and pink."
          widths={[480, 960]}
          sizes="(min-width: 768px) 460px, 92vw"
          class="h-[340px] w-full object-cover object-[45%_50%]"
        />
      </div>
      <div class="pb-5 pr-2 pt-5 md:pr-10">
        <h2 class="mb-4 font-display text-[clamp(26px,3vw,40px)] font-extrabold leading-[1.1] text-navy md:whitespace-nowrap">
          Not sure where to start?
        </h2>
        <p class="mb-[30px] max-w-[32em] text-lg leading-relaxed text-ink-soft">
          Answer a few questions about your kids and get a plan you can stick on the fridge. It
          takes about three minutes, and we do not ask for your email to give it to you.
        </p>
        <Button href="/plan" variant="primary" size="lg">Build your family plan</Button>
      </div>
    </div>
  </Container>
</Base>

<script>
  const form = document.getElementById('updates-form') as HTMLFormElement | null;
  const ok = document.getElementById('updates-ok');
  const err = document.getElementById('updates-err');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = String(new FormData(form).get('email') ?? '').trim();
    if (!email) return;
    if (ok) ok.hidden = true;
    if (err) err.hidden = true;
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      if (ok) ok.hidden = false;
    } catch {
      if (err) err.hidden = false;
    }
  });
</script>
