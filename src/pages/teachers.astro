---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Scribble from '../components/Scribble.astro';
import Photo from '../components/Photo.astro';
import BandFilter from '../components/BandFilter.astro';
import classroom from '../assets/photos/classroom.jpg';

const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);

const STRANDS = [
  'What it is',
  'How it works',
  'Who controls it',
  'How it was built',
  'Risks and guardrails',
] as const;

const grouped = STRANDS.map((strand) => ({
  strand,
  items: concepts.filter((c) => c.data.strand === strand && c.data.classroom),
})).filter((g) => g.items.length > 0);

const total = grouped.reduce((n, g) => n + g.items.length, 0);

// Every concept carries all four bands, so choosing one never empties the page.
const allBands = ['4-6', '7-9', '10-12', '13+'];

/** Every classroom explainer closes with "It has landed when ...". On a page that
 *  gets scanned rather than read, that belongs on its own line with a label. */
function splitLanding(text: string): [string, string | null] {
  const i = text.indexOf('It has landed when');
  if (i === -1) return [text, null];
  return [text.slice(0, i).trim(), text.slice(i).replace(/^It has landed when /, '').trim()];
}
---

<Base
  title="For teachers"
  description={`${total} classroom activities for teaching kids how media and AI actually work. Each one is a single lesson, most need no devices, and every one has a version for ages 4 to 6 through 13 and up.`}
>
  <header class="border-b border-line bg-surface-2 py-14 sm:py-20">
    <Container>
      {/* Text left, photograph right, the same shape as the other landing pages.
          A narrow column left most of a wide screen empty. */}
      <div class="grid items-center gap-x-12 gap-y-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div>
        <p class="font-display text-sm font-bold uppercase tracking-[0.14em] text-secondary-deep">
          For teachers
        </p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{total} lessons you can run this week</h1>
        <p class="mt-5 text-lg text-ink-soft">
          Most schools have told students what they may and may not do with AI. Far fewer have
          taught them how any of it works. In a 2026 survey of 1,204 children, three quarters said
          their school had set the rules and only just over half had been taught to use these tools
          safely. The rules are the easy half.
        </p>
        <p class="mt-4 text-lg text-ink-soft">
          Every activity below is one lesson, and most need no devices at all. Pick the age you
          teach once, at the top, and the whole page rewrites itself to that age. Then print it.
          You should not have to open thirteen pages and choose the age on each one.
        </p>
        <p class="mt-6 no-print">
          <button
            type="button"
            onclick="window.print()"
            class="rounded-full bg-primary px-5 py-2.5 font-semibold text-on-primary transition hover:brightness-110"
          >
            Print this page
          </button>
        </p>
        </div>

        <Photo
          src={classroom}
          alt="Seen from the back of a classroom, students at desks facing a teacher standing at the whiteboard."
          position="35% 45%"
          size={320}
          class="no-print"
        />
      </div>
    </Container>
  </header>

  <Container width="prose" class="pb-14">
    <BandFilter
      bands={allBands}
      label="Which age group are you teaching?"
      allLabel="Every age"
    />

    <p class="mt-8 text-ink-soft no-print">
      Each activity below carries the version for the age you picked: how to pitch the idea to a
      room that age, and what it sounds like when it has landed. Say it in your own words. The point
      of the age is the altitude, meaning how much of the machinery a class that age can hold.
    </p>

    <div class="mt-10">
    {grouped.map((group) => (
      <section class="mb-14">
        <h2 class="relative inline-block font-display text-sm font-bold uppercase tracking-[0.14em] text-secondary-deep">
          {group.strand}
          <Scribble type="underline" class="absolute -bottom-2 left-0 h-2 w-full" />
        </h2>

        <div class="mt-8 grid gap-5">
          {group.items.map((c) => (
            <article class="print-keep rounded-3xl border-2 border-line bg-surface p-6 sm:p-7">
              <h3 class="font-display text-xl font-extrabold">
                <a href={`/conversations/${c.id}`} class="hover:text-primary">{c.data.title}</a>
              </h3>
              <p class="mt-2 border-l-4 border-secondary pl-4 text-ink-soft">{c.data.idea}</p>
              {c.data.classSteps.length > 0 ? (
                <div class="mt-5">
                  <p class="font-display text-sm font-bold uppercase tracking-[0.12em] text-secondary-deep">
                    Run it like this
                  </p>
                  <ol class="mt-3 grid gap-2.5">
                    {c.data.classSteps.map((step, i) => (
                      <li class="flex gap-3 leading-relaxed">
                        <span
                          class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-3 font-display text-sm font-bold"
                          aria-hidden="true"
                        >
                          {i + 1}
                        </span>
                        <span>{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ) : (
                <p class="mt-4 leading-relaxed">{c.data.classroom}</p>
              )}

              {c.data.bands.map((b) => {
                const [pitch, landing] = splitLanding(b.inClass ?? b.explain);
                return (
                  <section
                    data-band-panel={b.band}
                    class="mt-5 rounded-2xl border border-line bg-surface-2 p-5"
                  >
                    <p class="font-display text-sm font-bold uppercase tracking-[0.12em] text-primary-text">
                      Ages {b.band}
                    </p>
                    <p class="mt-2 leading-relaxed">{pitch}</p>
                    {landing && (
                      <p class="mt-3 border-t border-line pt-3 text-[0.97rem]">
                        <span class="font-semibold">You are listening for</span> {landing}
                      </p>
                    )}
                  </section>
                );
              })}

            </article>
          ))}
        </div>
      </section>
    ))}
    </div>

    <section class="mt-4 rounded-3xl border-2 border-primary/35 bg-primary/8 p-6 sm:p-7 no-print">
      <h2 class="font-display text-xl font-extrabold">Using these with families</h2>
      <p class="mt-3 leading-relaxed">
        The same ideas are written for parents, one age at a time, under{' '}
        <a href="/conversations" class="font-semibold text-primary hover:underline">conversations</a>.
        Sending that page home is worth more than it looks. A lesson lands harder when somebody at
        the kitchen table asks about it the same evening, and most of these children are having the
        conversation nowhere else: in the same survey, more than four in ten said no parent had ever
        talked to them about using AI safely.
      </p>
    </section>
  </Container>
</Base>
