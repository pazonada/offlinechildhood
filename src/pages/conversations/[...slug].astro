---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import BandFilter from '../../components/BandFilter.astro';
import PrevNext from '../../components/PrevNext.astro';
import BackLink from '../../components/BackLink.astro';
import Scribble from '../../components/Scribble.astro';
import Photo from '../../components/Photo.astro';

export async function getStaticPaths() {
  // Sorted so prev and next follow the curriculum order rather than file order.
  const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);
  return concepts.map((c, i) => ({
    params: { slug: c.id },
    props: {
      concept: c,
      prev: concepts[i - 1],
      next: concepts[i + 1],
      position: i + 1,
      total: concepts.length,
    },
  }));
}

const { concept, prev, next, position, total } = Astro.props;
const { Content } = await render(concept);
const c = concept.data;
const decisions = await Promise.all(c.relatedDecisions.map((ref) => getEntry(ref)));
---

<Base title={c.title} description={c.description}>
  <article>
    <header class="border-b border-line bg-surface-2 py-14 sm:py-20">
      <Container width="prose">
        <BackLink href="/conversations" label="All conversations" />
        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 font-display text-sm font-bold uppercase tracking-[0.14em] text-secondary-deep">
          <span>{c.strand}</span>
          <span class="text-ink-soft/60" aria-hidden="true">/</span>
          <span class="text-ink-soft">{position} of {total}</span>
        </p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{c.title}</h1>
        <p class="mt-6 border-l-4 border-secondary pl-5 text-xl leading-relaxed text-ink">
          {c.idea}
        </p>
      </Container>
    </header>

    <Container width="prose">
      <BandFilter bands={c.bands.map((b) => b.band)} />

      <div class="py-12">
        <h2 class="relative inline-block font-display text-2xl font-extrabold">
          How to explain it, by age
          <Scribble type="underline" class="absolute -bottom-3 left-0 h-2.5 w-full" />
        </h2>
        {/* The mark is absolutely positioned, so it adds no height of its own.
            This margin has to clear it as well as separate the paragraph. */}
        <p class="mt-7 text-ink-soft">
          Same idea every time. What changes is how much of the machinery a kid can hold, so pick the
          version that fits and go up a band when it stops being interesting.
        </p>

        <div class="mt-8 grid gap-6">
          {c.bands.map((b) => (
            <section
              data-band-panel={b.band}
              class="rounded-3xl border-2 border-line bg-surface-2 p-6 sm:p-7"
              aria-labelledby={`band-${b.band}`}
            >
              <h3 id={`band-${b.band}`} class="font-display text-xl font-extrabold text-ink">
                Ages {b.band}
              </h3>

              <p class="mt-4 leading-relaxed">{b.explain}</p>

              <div class="mt-5 rounded-2xl bg-surface p-5">
                <p class="font-display text-sm font-bold uppercase tracking-[0.12em] text-primary-text">
                  Try this
                </p>
                <p class="mt-2 leading-relaxed">{b.tryThis}</p>
              </div>

              <div class="mt-4 rounded-2xl bg-surface p-5">
                <p class="font-display text-sm font-bold uppercase tracking-[0.12em] text-secondary-deep">
                  Listen for
                </p>
                <p class="mt-2 leading-relaxed">{b.listenFor}</p>
              </div>

              {b.ifMoreExperienced && (
                <p class="mt-4 border-t border-line pt-4 text-[0.97rem] text-ink-soft">
                  <span class="font-semibold text-ink">If she already has more access than most.</span>{' '}
                  {b.ifMoreExperienced}
                </p>
              )}
            </section>
          ))}
        </div>

        {c.image && (
          <Photo
            src={c.image}
            alt={c.imageAlt ?? ''}
            position={c.imageSpotlight}
            ratio={c.imageRatio}
            size={c.imageRatio ? 672 : 360}
            class="mt-16"
          />
        )}

        <div class="prose mt-16">
          <Content />
        </div>

        {c.misconceptions.length > 0 && (
          <section class="mt-16 border-t border-line pt-12">
            <h2 class="font-display text-2xl font-extrabold">Misconceptions to address</h2>
            <ul class="mt-5 grid gap-3">
              {c.misconceptions.map((m) => (
                <li class="rounded-2xl border border-line bg-surface-2 p-5 leading-relaxed">{m}</li>
              ))}
            </ul>
          </section>
        )}

        {c.classroom && (
          <section class="mt-16 rounded-3xl border-2 border-primary/35 bg-primary/8 p-6 sm:p-7">
            <h2 class="font-display text-xl font-extrabold">Running this with a class</h2>
            <p class="mt-3 leading-relaxed">{c.classroom}</p>
          </section>
        )}

        {decisions.length > 0 && (
          <section class="mt-16 border-t border-line pt-12">
            <h2 class="font-display text-2xl font-extrabold">The decision this connects to</h2>
            <ul class="mt-5 grid gap-3">
              {decisions.map((d) => d && (
                <li>
                  <a href={`/decisions/${d.id}`} class="block rounded-2xl border border-line bg-surface-2 p-5 transition hover:border-ink">
                    <span class="font-display text-lg font-extrabold text-ink">{d.data.question}</span>
                    <span class="mt-1 block text-ink-soft">{d.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <PrevNext
          label="Conversations"
          backHref="/conversations"
          backLabel={`See all ${total} conversations`}
          prev={prev && { href: `/conversations/${prev.id}`, title: prev.data.title, kicker: prev.data.strand }}
          next={next && { href: `/conversations/${next.id}`, title: next.data.title, kicker: next.data.strand }}
        />
      </div>
    </Container>
  </article>
</Base>
