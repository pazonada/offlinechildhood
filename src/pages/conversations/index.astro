---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Photo from '../../components/Photo.astro';
import ballPit from '../../assets/photos/ball-pit.jpg';

const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);

const STRANDS = [
  'What it is',
  'How it works',
  'Who controls it',
  'How it was built',
  'Risks and guardrails',
] as const;

const grouped = STRANDS.map((strand) => ({
  strand,
  items: concepts.filter((c) => c.data.strand === strand),
})).filter((g) => g.items.length > 0);
---

<Base
  title="Conversations"
  description="Critical media literacy for kids, one idea at a time, explained at four different ages. What these technologies are, how they work, who owns them, and how to stay safe."
>
  <header class="border-b border-line bg-surface-2 py-16 sm:py-24">
    <Container width="prose">
      <h1 class="text-4xl font-extrabold sm:text-5xl">The conversations</h1>
      <p class="mt-5 text-lg text-ink-soft">
        Limits are half the work. The other half is a kid who understands what these systems are,
        how they work, who owns them, and what they do with her attention and her data. She will use
        this technology in her career. She should not be mystified by it.
      </p>
      <p class="mt-4 text-lg text-ink-soft">
        Every idea below is written four times, for ages 4 to 6, 7 to 9, 10 to 12, and 13 and up.
        Start at any age. A four-year-old can understand that a person chose what she is watching.
      </p>
    
      <Photo
        src={ballPit}
        alt="A small child sits in a vast pit of blue and green plastic balls, seen from directly above."
        position="28% 30%"
        size={340}
        class="mt-10"
      />
</Container>
  </header>

  <Container width="prose" class="py-14">
    {grouped.map((group) => (
      <section class="mb-14">
        <h2 class="font-display text-sm font-bold uppercase tracking-[0.14em] text-secondary-deep">
          {group.strand}
        </h2>
        <ul class="mt-4 grid gap-4">
          {group.items.map((c) => (
            <li>
              <a
                href={`/conversations/${c.id}`}
                class="group block rounded-3xl border-2 border-line bg-surface p-6 transition hover:border-secondary hover:bg-surface-2"
              >
                <h3 class="font-display text-xl font-extrabold text-ink">{c.data.title}</h3>
                <p class="mt-2 leading-relaxed text-ink">{c.data.idea}</p>
                <p class="mt-3 flex flex-wrap gap-1.5">
                  {c.data.bands.map((b) => (
                    <span class="rounded-full bg-surface-3 px-2.5 py-1 text-xs font-bold text-ink-soft">
                      {b.band}
                    </span>
                  ))}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </Container>
</Base>
