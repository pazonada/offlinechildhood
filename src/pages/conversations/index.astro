---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Scribble from '../../components/Scribble.astro';
import speechBubble from '../../assets/photos/volodymyr-hryshchenko-V5vqWC9gyEU-unsplash.jpg';

const concepts = (await getCollection('concepts')).sort((a, b) => a.data.order - b.data.order);

const STRANDS = [
  'What it is',
  'How it works',
  'Who controls it',
  'How it was built',
  'Risks and guardrails',
] as const;

const grouped = STRANDS.map((strand) => ({
  strand,
  items: concepts.filter((c) => c.data.strand === strand),
})).filter((g) => g.items.length > 0);
---

<Base
  title="Conversations"
  description="Critical media literacy for kids, one idea at a time, explained at four different ages. What these technologies are, how they work, who owns them, and how to stay safe."
>
  <header class="border-b border-line bg-surface-2 py-14">
    <Container>
      <div class="grid items-center gap-x-12 gap-y-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div>
          <h1 class="font-display text-[clamp(36px,4vw,50px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
            The{' '}
            <span class="relative inline-block">
              conversations
              <Scribble type="underline" class="absolute -bottom-1 -left-1 h-3.5 w-[calc(100%+12px)]" color="var(--accent)" />
            </span>
          </h1>
          <p class="mt-[26px] max-w-[36em] text-[1.09rem] leading-[1.66] text-ink-soft">
            Limits help, but kids need to understand what these systems are, how they work, who
            owns them, and what they do with their attention and their data. They will use this
            technology in their career, so it shouldn't be mystifying.
          </p>
          <p class="mt-4 max-w-[36em] text-[1.09rem] leading-[1.66] text-ink-soft">
            Most kids are having none of these conversations. In a{' '}
            <a href="https://www.commonsensemedia.org/press-releases/common-sense-media-releases-inaugural-annual-study-on-ai-use-by-tweens-and-teens" class="underline decoration-line-dark underline-offset-4 hover:decoration-primary">2026 survey of 1,204 children aged 9 to 17</a>,
            86% used AI and nearly a quarter used it every day, but more than four in ten
            said no parent or guardian had ever talked to them about using it safely.
          </p>
          <p class="mt-4 max-w-[36em] text-[1.09rem] leading-[1.66] text-ink-soft">
            Every idea below is written for a range of ages. Start at any age.
          </p>
        </div>

        <div class="overflow-hidden rounded-[240px_240px_24px_24px] bg-surface-3">
          <Image
            src={speechBubble}
            alt="A green paper speech bubble on a bed of yellow lined notepaper, holding three crumpled yellow paper balls."
            widths={[520, 1040]}
            sizes="(min-width: 768px) 480px, 92vw"
            class="h-[400px] w-full object-cover"
          />
        </div>
      </div>
    </Container>
  </header>

  <div class="mx-auto w-full max-w-[900px] px-6 pt-14 sm:px-10">
    {grouped.map((group) => (
      <section class="mb-16">
        <h2 class="mb-[22px] inline-block font-label text-[13px] font-bold uppercase tracking-[0.16em] text-primary-text">
          {group.strand}
        </h2>
        <ul class="flex flex-col gap-4">
          {group.items.map((c) => (
            <li>
              <a
                href={`/conversations/${c.id}`}
                class="block rounded-[26px] border-2 border-line bg-surface px-[30px] pb-6 pt-[26px] transition hover:border-accent hover:bg-surface-warm"
              >
                <h3 class="font-display text-[23px] font-extrabold leading-[1.22] text-navy">
                  {c.data.title}
                </h3>
                <p class="mt-3 text-[1.03rem] leading-relaxed text-ink">{c.data.idea}</p>
                <div class="mt-[18px] flex flex-wrap gap-[7px]">
                  {c.data.bands.map((b) => (
                    <span class="rounded-full bg-surface-3 px-[11px] py-[5px] font-label text-xs font-bold text-ink-soft">
                      {b.band}
                    </span>
                  ))}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
