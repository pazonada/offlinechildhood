---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StanceLadder from '../../components/StanceLadder.astro';
import PrevNext from '../../components/PrevNext.astro';
import Sources from '../../components/Sources.astro';
import Photo from '../../components/Photo.astro';

export async function getStaticPaths() {
  // Sorted so prev and next follow the reading order rather than file order.
  const decisions = (await getCollection('decisions')).sort((a, b) => a.data.order - b.data.order);
  return decisions.map((d, i) => ({
    params: { slug: d.id },
    props: {
      decision: d,
      prev: decisions[i - 1],
      next: decisions[i + 1],
      total: decisions.length,
    },
  }));
}

const { decision, prev, next, total } = Astro.props;
const { Content } = await render(decision);
const d = decision.data;

const picks = await Promise.all(d.picks.map((ref) => getEntry(ref)));
const concepts = await Promise.all(d.relatedConcepts.map((ref) => getEntry(ref)));
---

<Base title={d.title} description={d.description}>
  <article>
    {/* Full-bleed blue hero carrying the question and the short answer. */}
    <header class="bg-primary text-on-navy-bright">
      <div class="mx-auto max-w-[860px] px-6 pb-[58px] pt-10 sm:px-10">
        <a
          href="/decisions"
          class="font-label text-[13px] font-bold tracking-[0.04em] text-on-primary-faint transition hover:text-on-navy-bright"
        >
          &larr; All decisions
        </a>
        <p class="mb-4 mt-[30px] font-label text-xs font-bold uppercase tracking-[0.22em] text-accent-light">
          Decision {d.order} of {total}
        </p>
        <h1 class="mb-[30px] font-display text-[clamp(32px,4vw,50px)] font-extrabold leading-[1.08] tracking-[-0.015em] text-on-navy-bright">
          {d.question}
        </h1>
        <h2 class="mb-3 font-label text-xs font-bold uppercase tracking-[0.22em] text-accent-light">
          The short answer
        </h2>
        <p class="text-[1.1rem] leading-[1.68] text-on-primary-soft">{d.shortAnswer}</p>
      </div>
    </header>

    <div class="article-col pt-[54px]">
      <StanceLadder stances={d.stances} />

      {d.image && (
        <Photo
          src={d.image}
          alt={d.imageAlt ?? ''}
          position={d.imageSpotlight}
          ratio={d.imageRatio}
          size={d.imageRatio ? 672 : 360}
          class="mt-14"
        />
      )}

      <div class="prose mt-2">
        <Content />
      </div>

      {concepts.length > 0 && (
        <section class="mt-[84px]">
          <h2 class="sun-heading mb-2 font-display text-[29px] font-extrabold text-navy">Talk about it</h2>
          <p class="mb-[22px] text-[1.03rem] leading-relaxed text-ink-soft">
            Rules do half the work. These are the conversations that do the other half, written for
            every age from four up.
          </p>
          <ul class="flex flex-col gap-7">
            {concepts.map((c) => c && (
              <li class="grid grid-cols-[6px_minmax(0,1fr)] gap-[22px]">
                <span class="rounded-[3px] bg-accent" aria-hidden="true"></span>
                <div>
                  <p class="mb-2 font-label text-[11.5px] font-bold uppercase tracking-[0.2em] text-ink-soft">
                    Conversation
                  </p>
                  <a
                    href={`/conversations/${c.id}`}
                    class="text-balance text-[21px] font-semibold leading-[1.34] text-primary-text underline decoration-panel-blue-line-strong decoration-[1.5px] underline-offset-4 transition hover:decoration-primary"
                  >
                    {c.data.title}
                  </a>
                  <p class="mt-2.5 text-[1rem] leading-relaxed text-ink-soft">{c.data.idea}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <PrevNext
        label="Decisions"
        backHref="/decisions"
        backLabel={`See all ${total} decisions`}
        prev={prev && { href: `/decisions/${prev.id}`, title: prev.data.question, kicker: `Decision ${prev.data.order}` }}
        next={next && { href: `/decisions/${next.id}`, title: next.data.question, kicker: `Decision ${next.data.order}` }}
      />
    </div>

    {/* Full bleed, so the commercial aside reads as separate from the answer. */}
    {picks.length > 0 && (
      <section class="mt-[84px] bg-panel-blue-deep">
        <div class="article-col pb-[66px] pt-[62px]">
          <h2 class="mb-2 font-display text-[27px] font-extrabold text-navy">
            If you decided to buy something
          </h2>
          <p class="mb-[26px] max-w-[44em] text-[1.03rem] leading-relaxed text-ink-soft">
            Only worth reading once you have made the call above. Nothing here is required, and the
            cheapest answer to most of these problems is no purchase at all.
          </p>
          <div class="grid gap-4 sm:grid-cols-2">
            {picks.map((p) => p && (
              <a
                href={p.data.url}
                target="_blank"
                rel="noopener"
                class="block rounded-[18px] bg-surface px-[26px] py-6 transition hover:bg-card-hover-cool"
              >
                <span class="flex items-baseline justify-between gap-3">
                  <span class="text-balance font-display text-[21px] font-extrabold text-navy">{p.data.name}</span>
                  <span class="font-label text-[15px] font-bold text-primary-text" aria-hidden="true">&#8599;</span>
                </span>
                <span class="mt-1 block font-label text-[11.5px] font-bold uppercase tracking-[0.16em] text-ink-soft">
                  {p.data.maker} &middot; {p.data.tags[0]}
                </span>
                <span class="mt-3 block text-[1rem] leading-[1.58] text-ink">{p.data.summary}</span>
                <span class="mt-3.5 block text-[0.95rem] font-medium text-navy">{p.data.price}</span>
                <span class="mt-3.5 block border-t border-card-line-cool pt-3.5 text-sm leading-[1.55] text-ink-soft">
                  {p.data.limitations}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.sources.length > 0 && (
      <div class="article-col pt-[34px]">
        <Sources ids={d.sources} />
      </div>
    )}
  </article>
</Base>
