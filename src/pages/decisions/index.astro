---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Photo from '../../components/Photo.astro';
import climbing from '../../assets/photos/climbing.jpg';
import Button from '../../components/Button.astro';

const decisions = (await getCollection('decisions')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Decisions"
  description="The device calls every family has to make, each with a clear answer and three ways to act on it."
>
  <header class="border-b border-line bg-surface-2 py-16 sm:py-24">
    <Container width="prose">
      <h1 class="text-4xl font-extrabold sm:text-5xl">The decisions</h1>
      <p class="mt-5 text-lg text-ink-soft">
        A handful of calls account for most of what a childhood looks like: the first phone, what
        happens in the bedroom at night, who owns the tablet. Each one gets a straight answer and
        three ways to act on it, so you can start where you actually are.
      </p>
      <Button href="/plan" variant="primary" size="lg" class="mt-8">Build your family plan</Button>
    
      <Photo
        src={climbing}
        alt="Two children partway up an indoor climbing wall, seen from below, both facing the wall."
        ratio="16/9"
        position="50% 32%"
        class="mt-10"
      />
</Container>
  </header>

  <Container width="prose" class="py-14">
    <ol class="grid gap-5">
      {decisions.map((d) => (
        <li>
          <a
            href={`/decisions/${d.id}`}
            class="group block rounded-3xl border-2 border-line bg-surface p-6 transition hover:border-primary hover:bg-surface-2 sm:p-8"
          >
            <p class="font-display text-sm font-bold uppercase tracking-[0.14em] text-primary-text">
              Decision {d.data.order}
            </p>
            <h2 class="mt-2 font-display text-2xl font-extrabold text-ink">{d.data.question}</h2>
            <p class="mt-3 text-ink-soft">{d.data.description}</p>
            <p class="mt-4 font-display font-bold text-ink group-hover:text-primary-text">
              Read the answer
              <span aria-hidden="true" class="inline-block transition group-hover:translate-x-1">&nbsp;&rarr;</span>
            </p>
          </a>
        </li>
      ))}
    </ol>
  </Container>
</Base>
