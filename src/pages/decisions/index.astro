---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Scribble from '../../components/Scribble.astro';
import climbing from '../../assets/photos/climbing.jpg';
import Button from '../../components/Button.astro';

const decisions = (await getCollection('decisions')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Decisions"
  description="The device calls every family has to make, each with a clear answer and three ways to act on it."
>
  <header class="pt-8">
    <Container>
      <div class="grid items-center gap-x-14 gap-y-10 md:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)]">
        <div>
          <h1 class="font-display text-[clamp(38px,4.5vw,60px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
            The{' '}
            <span class="relative inline-block">
              decisions
              <Scribble type="underline" class="absolute -bottom-1 -left-1 h-3.5 w-[calc(100%+12px)]" color="var(--accent)" />
            </span>
          </h1>
          <p class="mt-[30px] max-w-[34em] text-[1.1rem] leading-[1.65] text-ink-soft">
            A handful of thoughtful decisions account for most of what a childhood looks like: when to
            get the first phone, who owns the tablet, how to navigate tech discussions with your
            school system. Here's the straight answers, as well as ways to act on them.
          </p>
          <Button href="/plan" variant="primary" size="lg" class="mt-8">Build your family plan</Button>
        </div>

        <div class="overflow-hidden rounded-[240px_240px_24px_24px] bg-surface-3">
          <Image
            src={climbing}
            alt="Two children partway up an indoor climbing wall, seen from below, both facing the wall."
            widths={[520, 1040]}
            sizes="(min-width: 768px) 480px, 92vw"
            class="h-[380px] w-full object-cover object-[58%_46%]"
          />
        </div>
      </div>
    </Container>
  </header>

  <Container class="pt-[76px]">
    <ol class="max-w-[62rem] border-t border-line-strong">
      {decisions.map((d) => (
        <li>
          <a
            href={`/decisions/${d.id}`}
            class="grid grid-cols-[minmax(0,1fr)] gap-x-7 gap-y-3 rounded-r-[26px] border-b border-line-strong py-[34px] pl-5 pr-7 transition hover:bg-surface-3 sm:grid-cols-[88px_minmax(0,1fr)]"
          >
            <span class="font-label text-[40px] font-extrabold leading-none text-accent" aria-hidden="true">
              {pad(d.data.order)}
            </span>
            <div>
              <h2 class="mb-2.5 font-display text-[27px] font-extrabold leading-[1.2] text-navy">
                {d.data.question}
              </h2>
              <p class="mb-3.5 max-w-[44em] text-[1.03rem] leading-relaxed text-ink-soft">
                {d.data.description}
              </p>
              <span class="font-label text-[13px] font-bold uppercase tracking-[0.06em] text-primary-text">
                Read the answer
                <span aria-hidden="true">&nbsp;&rarr;</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </Container>
</Base>
