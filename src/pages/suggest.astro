---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
---

<Base
  title="Suggest a topic"
  description="Tell us what the site should cover next: a decision you're facing, a scenario we haven't written about, or a subject your family needs explained. Free, and nothing you send is published."
>
  <header class="border-b border-line bg-surface-2 py-14">
    <Container>
      <div class="max-w-[46em]">
        <p class="mb-3.5 font-label text-xs font-bold uppercase tracking-[0.22em] text-primary-text">
          Help us build this
        </p>
        <h1 class="font-display text-[clamp(38px,4vw,52px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
          What should we cover?
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          The site grows by covering what families are actually navigating. If you came here for
          something and did not find it, or you are in the middle of a situation the site should
          have a page about, describe it below. We read everything, and the best submissions
          become new decisions, conversations, and answers on the site.
        </p>
      </div>
    </Container>
  </header>

  <div class="mx-auto w-full max-w-[900px] px-6 pb-24 pt-12 sm:px-10">
    <section class="rounded-[28px] border-2 border-accent bg-panel-accent px-9 pb-8 pt-[30px]">
      <h2 class="font-display text-[24px] font-extrabold text-navy">Make a suggestion</h2>
      <p class="mt-2 text-[1.01rem] leading-[1.62] text-ink">
        Suggest a topic, scenario, or report an issue. For suggestions, please leave out names,
        schools, and anything that would identify your kid. Nothing you send is published; it
        goes to our inbox and shapes what we write next. If you include your email, we use it
        only to follow up.
      </p>

      <form id="ask-form" class="mt-6 flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="ask-topic" class="text-sm font-semibold text-ink">The topic or scenario</label>
          <textarea
            id="ask-topic"
            name="topic"
            rows="5"
            maxlength="3000"
            required
            placeholder="What you're navigating, or what you wish this site had a page about."
            class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-3 text-[1rem] leading-[1.6] text-ink placeholder:text-ink-soft/70"
          ></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="ask-ages" class="text-sm font-semibold text-ink">Your kids' ages <span class="font-normal text-ink-soft">(optional)</span></label>
            <input
              id="ask-ages"
              name="ages"
              type="text"
              maxlength="100"
              placeholder="e.g. 6 and 9"
              class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="ask-email" class="text-sm font-semibold text-ink">Your email <span class="font-normal text-ink-soft">(optional, for a follow-up)</span></label>
            <input
              id="ask-email"
              name="email"
              type="email"
              maxlength="200"
              placeholder="you@example.com"
              class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
            />
          </div>
        </div>

        <button
          type="submit"
          class="self-start rounded-full bg-primary px-7 py-[13px] font-label text-[16px] font-bold text-on-navy-bright transition hover:bg-primary-strong"
        >
          Send it
        </button>
      </form>

      <p id="ask-ok" hidden class="mt-4 flex items-start gap-2 leading-relaxed text-green-deep">
        <svg viewBox="0 0 20 20" class="mt-1 h-[17px] w-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg>
        Thank you. We read every suggestion, and the best ones become pages.
      </p>
      <p id="ask-err" hidden class="mt-4 leading-relaxed text-coral" role="alert">
        That did not send. Please try again, or email{' '}
        <a href="mailto:hello@offlinechildhood.com" class="underline underline-offset-4">hello@offlinechildhood.com</a>.
      </p>
    </section>

    <section class="mt-14 rounded-[28px] border-[1.5px] border-panel-blue-line bg-panel-blue px-9 pb-8 pt-[30px]">
      <h2 class="font-display text-[24px] font-extrabold text-navy">Need advice right now?</h2>
      <p class="mt-2.5 max-w-[44em] text-[1.03rem] leading-[1.7] text-ink">
        This form feeds the site; it is not a conversation. For advice from other parents,
        caregivers, and teachers, bring your situation to{' '}
        <a
          href="https://www.reddit.com/r/OfflineChildhood/"
          target="_blank"
          rel="noopener"
          class="font-semibold text-primary-text underline underline-offset-4 hover:text-navy"
        >r/OfflineChildhood</a>.
        It is brand new, which means the first families there get to set its tone. Same rules as
        here: no names, no photos of kids, nothing identifying.
      </p>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  const ok = document.getElementById('ask-ok');
  const err = document.getElementById('ask-err');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const payload = {
      topic: String(data.get('topic') ?? ''),
      ages: String(data.get('ages') ?? ''),
      email: String(data.get('email') ?? ''),
    };
    if (!payload.topic.trim()) return;

    if (ok) ok.hidden = true;
    if (err) err.hidden = true;

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.hidden = true;
      if (ok) ok.hidden = false;
    } catch {
      if (err) err.hidden = false;
    }
  });
</script>
