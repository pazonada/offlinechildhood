---
// Scratch page for judging the hand-drawn marks. Delete once decided.
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Scribble from '../components/Scribble.astro';

const marks = [
  ['underline', 'Underline'],
  ['underline-double', 'Double underline'],
  ['circle', 'Circle'],
  ['arrow', 'Arrow'],
  ['arrow-down', 'Arrow down'],
  ['burst', 'Burst'],
  ['divider', 'Divider'],
  ['bracket', 'Bracket'],
  ['check', 'Tick'],
  ['box', 'Box'],
] as const;
---
<Base title="Style preview" description="Scratch page for choosing hand-drawn elements.">
  <Container class="py-16">
    <h1 class="text-4xl font-extrabold">Hand-drawn marks</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Inline SVG, about a kilobyte each. No licensing, no image service, no page weight. Scroll past
      the swatches to see them used in context, which is the part worth judging.
    </p>

    <h2 class="mt-14 font-display text-sm font-bold uppercase tracking-[0.14em] text-ink-soft">
      The marks
    </h2>
    <ul class="mt-5 grid gap-5 sm:grid-cols-3 lg:grid-cols-5">
      {marks.map(([type, label]) => (
        <li class="rounded-2xl border border-line bg-surface-2 p-5">
          <div class="grid h-20 place-items-center">
            <Scribble type={type} class="h-14 w-full" color="var(--accent)" />
          </div>
          <p class="mt-2 text-center text-sm font-semibold text-ink-soft">{label}</p>
        </li>
      ))}
    </ul>

    <h2 class="mt-16 font-display text-sm font-bold uppercase tracking-[0.14em] text-ink-soft">
      In context
    </h2>

    {/* 1. Heading with an underline */}
    <section class="mt-6 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">1. Section heading</p>
      <h3 class="relative mt-4 inline-block font-display text-3xl font-extrabold">
        We argue from what a childhood gains
        <Scribble type="underline-double" class="absolute -bottom-3 left-0 h-3 w-full" />
      </h3>
    </section>

    {/* 2. Circled number on a stance rung */}
    <section class="mt-5 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">2. Stance ladder</p>
      <div class="mt-4 flex items-center gap-4">
        <span class="relative grid h-12 w-12 shrink-0 place-items-center font-display text-xl font-extrabold">
          1
          <Scribble type="circle" class="absolute inset-0 h-full w-full" />
        </span>
        <div>
          <p class="font-display text-lg font-extrabold">Start here</p>
          <p class="text-ink-soft">Something you can hold from this week, without a fight.</p>
        </div>
      </div>
    </section>

    {/* 3. Arrow pointing at the call to action */}
    <section class="mt-5 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">3. Call to action</p>
      <div class="mt-6 flex items-center gap-3">
        <span class="hidden shrink-0 sm:block">
          <Scribble type="arrow" class="h-10 w-24" color="var(--primary)" />
        </span>
        <a href="#" class="rounded-full bg-primary px-7 py-3.5 font-display text-lg font-bold text-on-primary">
          Build your family plan
        </a>
      </div>
    </section>

    {/* 4. Tick list */}
    <section class="mt-5 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">4. What this looks like</p>
      <ul class="mt-4 grid gap-3">
        {['Charger lives in the kitchen', 'Alarm clock in every bedroom', 'Your phone follows the same rule'].map((t) => (
          <li class="flex items-start gap-3">
            <Scribble type="check" class="mt-1 h-5 w-6 shrink-0" color="var(--secondary)" width={3} />
            <span>{t}</span>
          </li>
        ))}
      </ul>
    </section>

    {/* 5. Boxed callout */}
    <section class="mt-5 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">5. Boxed emphasis</p>
      <div class="relative mt-5 inline-block px-6 py-4">
        <Scribble type="box" class="absolute inset-0 h-full w-full" color="var(--coral)" width={2} />
        <p class="relative font-display text-lg font-extrabold">If you do one thing, do this one.</p>
      </div>
    </section>

    {/* 6. Divider */}
    <section class="mt-5 rounded-3xl border border-line bg-surface-2 p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-ink-soft">6. Section divider</p>
      <Scribble type="divider" class="mt-5 h-3 w-full" color="var(--line)" width={3} />
    </section>
  </Container>
</Base>
