---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import cafeReader from '../assets/photos/bonnie-kittle-GiIZSko7Guk-unsplash.jpg';

const people = await getCollection('experts');
---

<Base
  title="People we read"
  description="Writers and researchers worth your time on children and technology, including ones who disagree with each other."
>
  <header class="border-b border-line bg-surface-2 py-14">
    <Container>
      <div class="grid items-center gap-x-12 gap-y-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
        <div>
          <h1 class="font-display text-[clamp(36px,4vw,50px)] font-extrabold leading-[1.04] tracking-[-0.015em] text-navy">
            People we read
          </h1>
          <p class="mt-6 max-w-[36em] text-[1.09rem] leading-[1.66] text-ink-soft">
            Being listed here is not an endorsement of everything someone argues. The list
            deliberately includes people who disagree with each other, because on this subject the
            disagreement is the most useful thing to understand. Each link goes to where they
            actually publish.
          </p>
        </div>

        <div class="overflow-hidden rounded-[240px_240px_24px_24px] bg-surface-3">
          <Image
            src={cafeReader}
            alt="A woman reading on a laptop at a cafe window, beside a shelf of board games and a trailing houseplant."
            widths={[520, 1040]}
            sizes="(min-width: 768px) 480px, 92vw"
            class="h-[400px] w-full object-cover object-[62%_50%]"
          />
        </div>
      </div>
    </Container>
  </header>

  <Container class="py-[52px]">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {people.map((p) => (
        <li class="flex flex-col rounded-[26px] border-2 border-line bg-surface px-7 pb-6 pt-[26px] transition hover:border-line-dark">
          <h2 class="font-display text-[21px] font-extrabold leading-[1.22] text-navy">{p.data.name}</h2>
          <p class="mt-1.5 text-[0.9rem] font-semibold text-primary-text">{p.data.role}</p>
          <p class="mt-3.5 leading-relaxed text-ink-soft">{p.data.focus}</p>

          <div class="mt-auto pt-5">
            <div class="flex flex-wrap items-center gap-x-[18px] gap-y-2 border-t border-line pt-4">
              <a
                href={p.data.url}
                target="_blank"
                rel="noopener"
                class="font-display font-bold text-primary-text underline underline-offset-4 hover:text-navy"
              >
                Read
                <span class="sr-only"> {p.data.name}</span>
              </a>

              {p.data.instagram && (
                <a
                  href={`https://www.instagram.com/${p.data.instagram}/`}
                  target="_blank"
                  rel="noopener"
                  class="text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
                >
                  Instagram<span class="sr-only"> for {p.data.name}</span>
                </a>
              )}
              {p.data.linkedin && (
                <a
                  href={`https://www.linkedin.com/in/${p.data.linkedin}/`}
                  target="_blank"
                  rel="noopener"
                  class="text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
                >
                  LinkedIn<span class="sr-only"> for {p.data.name}</span>
                </a>
              )}
              {p.data.x && (
                <a
                  href={`https://x.com/${p.data.x}`}
                  target="_blank"
                  rel="noopener"
                  class="text-sm text-ink-soft underline underline-offset-4 hover:text-ink"
                >
                  X<span class="sr-only"> for {p.data.name}</span>
                </a>
              )}
            </div>
          </div>
        </li>
      ))}

      <li class="flex flex-col rounded-[26px] border-2 border-accent bg-panel-accent px-7 pb-6 pt-[26px]">
        <h2 class="font-display text-[21px] font-extrabold leading-[1.22] text-navy">
          Suggest a thought leader
        </h2>
        <p class="mt-3.5 leading-relaxed text-ink-soft">
          Know someone we should be reading? Submit their name or a link to where they publish.
        </p>
        <div class="mt-auto pt-5">
          <form id="suggest-form" class="flex flex-col gap-2.5">
            <label for="suggest-name" class="text-sm font-semibold text-ink">Name or link</label>
            <input
              id="suggest-name"
              name="suggestion"
              type="text"
              maxlength="500"
              placeholder="e.g. technosapiens.substack.com"
              class="w-full rounded-xl border-[1.5px] border-accent/60 bg-surface px-3.5 py-[11px] text-[1rem] text-ink placeholder:text-ink-soft/70"
            />
            <button
              type="submit"
              class="self-start rounded-full bg-primary px-6 py-[11px] font-label text-[15px] font-bold text-on-navy-bright transition hover:bg-primary-strong"
            >
              Submit
            </button>
          </form>
          <p id="suggest-ok" hidden class="flex items-start gap-2 leading-relaxed text-green-deep">
            <svg viewBox="0 0 20 20" class="mt-1 h-[17px] w-[17px] shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg>
            Thank you. We read every suggestion.
          </p>
          <p id="suggest-err" hidden class="leading-relaxed text-coral" role="alert">
            That did not send. Please try again, or email{' '}
            <a href="mailto:hello@offlinechildhood.com" class="underline underline-offset-4">hello@offlinechildhood.com</a>.
          </p>
        </div>
      </li>
    </ul>
  </Container>
</Base>

<script>
  const form = document.getElementById('suggest-form') as HTMLFormElement | null;
  const ok = document.getElementById('suggest-ok');
  const err = document.getElementById('suggest-err');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('#suggest-name');
    const value = input?.value.trim();
    if (!value || !ok || !err) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;

    // The thank-you only appears when the send actually succeeded. A failed
    // send says so instead of thanking the visitor for nothing.
    try {
      const res = await fetch('/api/suggest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ suggestion: value }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      err.hidden = true;
      ok.hidden = false;
    } catch {
      err.hidden = false;
      if (button) button.disabled = false;
    }
  });
</script>
