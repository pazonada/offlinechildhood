---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';

const people = await getCollection('experts');
---

<Base
  title="People we read"
  description="Writers and researchers worth your time on children and technology, including ones who disagree with each other."
>
  <header class="border-b border-line bg-surface-2 py-16 sm:py-24">
    <Container width="prose">
      <h1 class="text-4xl font-extrabold sm:text-5xl">People we read</h1>
      <p class="mt-5 text-lg text-ink-soft">
        Being listed here is not an endorsement of everything someone argues. The list deliberately
        includes people who disagree with each other, because on this subject the disagreement is
        the most useful thing to understand.
      </p>
    </Container>
  </header>

  <Container width="prose" class="py-14">
    <ul class="grid gap-4">
      {people.map((p) => (
        <li>
          <a
            href={p.data.url}
            target="_blank"
            rel="noopener"
            class="group block rounded-2xl border-2 border-line bg-surface p-6 transition hover:border-primary hover:bg-surface-2"
          >
            <p class="font-display text-xl font-extrabold text-ink">{p.data.name}</p>
            <p class="mt-0.5 text-sm font-semibold text-primary-text">{p.data.role}</p>
            <p class="mt-3 leading-relaxed text-ink-soft">{p.data.focus}</p>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Base>
